---
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";
import { CITIES } from "../lib/cities";
import { QUESTIONS } from "../lib/questions";
import { FILTER_MENU } from "../lib/filters";
import { MAP_HEIGHT, MAP_WIDTH, project } from "../lib/map";
import borders from "../data/africa-borders.json";

const dots = CITIES.map((city) => ({ name: city.name, ...project(city.lat, city.lon) }));
const description =
  "Réponds à dix questions et découvre les villes d'Afrique qui te ressemblent, parmi 115 villes dans les 54 pays.";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161a5c" />
    <title>Là-bas · Trouve ta ville</title>
  </head>
  <body>
    <div class="shell">
      <aside class="side">
        <Wordmark />
        <h1>
          Trouve ta ville, <em>là-bas.</em>
        </h1>
        <p class="lead">Pour la diaspora qui regarde vers le continent.</p>
        <div class="map">
          <svg
            id="map"
            viewBox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}
            role="img"
            aria-label="Carte de l'Afrique : plus une ville te ressemble, plus son point est gros et coloré"
          >
            <g class="land" aria-hidden="true">
              {borders.map((country) => (
                <path d={country.d} />
              ))}
            </g>
            {dots.map((dot) => (
              <circle
                class="dot"
                data-city={dot.name}
                cx={dot.x.toFixed(1)}
                cy={dot.y.toFixed(1)}
                r="3"
              >
                <title>{dot.name}</title>
              </circle>
            ))}
            <g id="highlights"></g>
          </svg>
        </div>
        <p class="map-legend" id="legend"></p>
      </aside>

      <main class="main">
        <div class="progress">
          <span id="counter" class="counter">
            Ça se dessine
          </span>
          <span class="track">
            <span id="progress"></span>
          </span>
          <span class="gauge-hint">Ton résultat se précise à chaque réponse.</span>
        </div>
        <form id="form" class="questions" aria-label="Tes réponses">
          {QUESTIONS.map((question, index) => (
            <fieldset
              class="question"
              data-question={question.id}
              data-max={question.max ?? 1}
              hidden={index > 0}
            >
              <legend>
                <span class="group">{question.group}</span>
                {question.title}
                {question.max && <span class="hint">Plusieurs choix possibles</span>}
              </legend>
              <div class="chips">
                {question.choices.map((choice) => (
                  <button
                    type="button"
                    class="chip"
                    aria-pressed="false"
                    data-value={JSON.stringify(choice.value)}
                  >
                    {choice.label}
                  </button>
                ))}
              </div>
              <div class="steps">
                <button type="button" class="back" data-step="back">
                  ← Retour
                </button>
                {question.max ? (
                  <button type="button" class="next" data-step="next">
                    Valider
                  </button>
                ) : (
                  <button type="button" class="skip" data-step="next">
                    Passer
                  </button>
                )}
              </div>
            </fieldset>
          ))}
          <div id="ready" class="ready" hidden>
            <h2>C'est prêt.</h2>
            <p>Trois villes te ressemblent plus que les autres. Découvre pourquoi.</p>
            <button type="button" id="reveal" class="primary">
              Voir mes villes
            </button>
            <button type="button" id="refine" class="secondary">
              Affiner encore (questions de plus)
            </button>
            <button type="button" class="back" data-step="back">
              ← Changer une réponse
            </button>
          </div>
        </form>

        <div id="outcome" class="outcome" hidden>
          <section class="filters" aria-label="Filtrer tes villes">
            <div class="filter-chips">
              {FILTER_MENU.map((entry) => (
                <button
                  type="button"
                  class="filter-chip"
                  data-filter={entry.key}
                  aria-pressed="false"
                >
                  {entry.label}
                </button>
              ))}
            </div>
            <p class="hint" id="filter-note">
              Les filtres retirent des villes ; l'ordre ne change jamais.
            </p>
          </section>

          <dialog id="filter-sheet" class="sheet" aria-labelledby="sheet-title">
            <form method="dialog" class="sheet-body">
              <h2 id="sheet-title"></h2>
              <p class="sheet-hint" id="sheet-hint"></p>
              <div class="sheet-options" id="sheet-options"></div>
              <button type="submit" class="primary">
                Voir mes villes
              </button>
            </form>
          </dialog>

          <section class="results" aria-labelledby="results-title">
            <h2 id="results-title">Tes trois villes</h2>
            <p class="hint" id="results-hint">
              Sans réponse, voici les villes qui plaisent au plus grand nombre.
            </p>
            <p class="hint" id="results-sub" hidden>
              Selon tes réponses, de la plus proche à la moins proche.
            </p>
            <div id="cards" class="cards"></div>
          </section>

          <section class="others" aria-labelledby="others-title">
            <h2 id="others-title">Toutes les autres villes</h2>
            <p class="hint" id="others-hint">
              Les 115 villes, triées selon tes réponses.
            </p>
            <ol id="rows" class="rows"></ol>
            <button type="button" id="more" class="more">
              Voir plus de villes
            </button>
          </section>

          <section class="further">
            <h2>Envie d'aller plus loin ?</h2>
            <p>
              Le questionnaire complet : tes contraintes (école, soins, visa), ce qui te pèse et ce
              qui te plaît, pour un classement plus fin.
            </p>
            <a href="/approfondir">Affiner avec le questionnaire complet</a>
          </section>
        </div>

        <footer class="footer">
          <p>
            Les résultats sont des propositions, pas des verdicts. Chaque note de ville renvoie à
            ses sources, sur la page de la ville. Les villes que les autorités déconseillent ne sont
            jamais proposées.
          </p>
          <p>Tes réponses restent dans ton navigateur : rien n'est enregistré ni envoyé.</p>
          <nav class="links" aria-label="Pages du site">
            <a href="/approfondir">Aller plus loin</a>
            <a href="/methode">Notre méthode</a>
            <a href="/mentions-legales">Mentions légales</a>
            <a href="/confidentialite">Confidentialité</a>
          </nav>
        </footer>
      </main>
    </div>

    <template id="card-template">
      <article class="card">
        <header class="card-head">
          <span class="rank"></span>
          <div>
            <h3 class="card-name"></h3>
            <p class="card-country"></p>
          </div>
          <span class="fit"></span>
        </header>
        <span class="bar">
          <span></span>
        </span>
        <p class="card-tagline"></p>
        <figure class="photo" hidden>
          <img alt="" width="1280" height="853" loading="lazy" />
          <figcaption></figcaption>
        </figure>
        <p class="card-pitch"></p>
        <div class="portrait-box" hidden>
          <h4 class="portrait-title"></h4>
          <ul class="portrait"></ul>
        </div>
        <details class="detail">
          <summary>
            <span class="when-closed">Voir le détail</span>
            <span class="when-open">Masquer le détail</span>
          </summary>
        </details>
      </article>
    </template>

    <template id="row-template">
      <li class="row">
        <details class="detail">
          <summary class="row-head">
            <span class="rank"></span>
            <span class="row-name">
              <b></b> <span class="row-country"></span>
            </span>
            <span class="fit"></span>
            <span class="row-tagline"></span>
            <span class="bar">
              <span></span>
            </span>
          </summary>
        </details>
      </li>
    </template>

    <template id="unsafe-template">
      <li class="row unsafe">
        <div class="row-head">
          <span class="rank"></span>
          <span class="row-name">
            <b></b> <span class="row-country"></span>
          </span>
          <span class="row-note">
            Déconseillée en ce moment par le ministère des Affaires étrangères. Elle garde sa place
            dans la liste, mais on ne te la propose pas.
          </span>
        </div>
      </li>
    </template>

    <template id="detail-template">
      <div class="detail-body">
        <div class="field" data-field="portrait">
          <h4 class="portrait-title"></h4>
          <ul class="portrait"></ul>
        </div>
        <div class="field" data-field="reputation">
          <span class="eyebrow">On dit</span>
          <p class="quote"></p>
        </div>
        <div class="field" data-field="surprise">
          <h4>Ce qui pourrait te surprendre</h4>
          <p></p>
        </div>
        <div class="field" data-field="neighbourhoods">
          <h4>Les quartiers</h4>
          <ul class="places"></ul>
          <p class="small">Loyers affichés, souvent négociables.</p>
        </div>
        <div class="field" data-field="reasons">
          <h4>Ses points forts pour toi</h4>
          <ul class="reasons"></ul>
        </div>
        <div class="field watch" data-field="watch">
          <h4>À savoir</h4>
          <p></p>
        </div>
        <a class="field full" data-field="full">
          Voir la fiche complète, critère par critère, avec ses sources
        </a>
      </div>
    </template>

    <script>
      import { bestMatches, rankCities, type Answers, type Match } from "../lib/ranking";
      import { gauge, isSettled, nextFreeQuestion } from "../lib/adaptive";
      import {
        applyFilters,
        FILTER_MENU,
        filtersFrom,
        type FilterOption,
        type Filters,
      } from "../lib/filters";
      import { answersBeforeLight, dotTier, placeLabels } from "../lib/map";
      import { linesFor } from "../lib/lines";
      import { photoFor } from "../lib/photos";

      const SVG = "http://www.w3.org/2000/svg";
      const form = document.getElementById("form") as HTMLFormElement;
      const answers: Record<string, unknown> = {};

      function readAnswers(): Answers {
        for (const fieldset of form.querySelectorAll<HTMLFieldSetElement>(".question")) {
          const id = fieldset.dataset.question as string;
          const picked = [
            ...fieldset.querySelectorAll<HTMLButtonElement>('[aria-pressed="true"]'),
          ].map((chip) => JSON.parse(chip.dataset.value as string));
          if (Number(fieldset.dataset.max) > 1) answers[id] = picked.length ? picked : undefined;
          else answers[id] = picked[0];
        }
        return answers as Answers;
      }

      function pick(chip: HTMLButtonElement) {
        const fieldset = chip.closest<HTMLFieldSetElement>(".question");
        if (!fieldset) return;
        const max = Number(fieldset.dataset.max);
        const wasOn = chip.getAttribute("aria-pressed") === "true";
        const chips = [...fieldset.querySelectorAll<HTMLButtonElement>(".chip")];
        if (max === 1) chips.forEach((other) => other.setAttribute("aria-pressed", "false"));
        else if (
          !wasOn &&
          chips.filter((c) => c.getAttribute("aria-pressed") === "true").length >= max
        )
          return;
        // « Je préfère ne pas dire » excludes the other answers, and they exclude it.
        if (max > 1 && !wasOn) {
          const silent = chip.dataset.value === "null";
          for (const other of chips)
            if ((other.dataset.value === "null") !== silent)
              other.setAttribute("aria-pressed", "false");
        }
        // Tapping the pressed chip again clears the question.
        chip.setAttribute("aria-pressed", String(!wasOn));
      }

      function renderMap(names: string[], scores: Map<string, number>) {
        const values = scores.size ? [...scores.values()] : [0];
        const best = Math.max(...values);
        const worst = Math.min(...values);
        const span = best - worst || 1;
        for (const dot of document.querySelectorAll<SVGCircleElement>("#map .dot")) {
          const name = dot.dataset.city as string;
          const relative =
            scores.size === 0 ? 0 : scores.has(name) ? (scores.get(name)! - worst) / span : 0;
          dot.setAttribute("r", (1.5 + relative * relative * 5).toFixed(1));
          dot.setAttribute(
            "class",
            `dot ${dotTier(relative)}${names.includes(name) ? " top" : ""}`,
          );
        }
        const highlights = document.getElementById("highlights") as unknown as SVGGElement;
        const points = names.map((name) => {
          const dot = document.querySelector<SVGCircleElement>(
            `#map .dot[data-city="${CSS.escape(name)}"]`,
          )!;
          return { name, x: Number(dot.getAttribute("cx")), y: Number(dot.getAttribute("cy")) };
        });
        highlights.replaceChildren(
          ...placeLabels(points).flatMap((label) => {
            const ring = document.createElementNS(SVG, "circle");
            ring.setAttribute("class", "ring");
            ring.setAttribute("cx", String(label.x));
            ring.setAttribute("cy", String(label.y));
            ring.setAttribute("r", "8");
            const text = document.createElementNS(SVG, "text");
            text.setAttribute("class", "label");
            text.setAttribute("x", String(label.anchor === "end" ? label.x - 12 : label.x + 12));
            text.setAttribute("y", String(label.labelY));
            text.setAttribute("text-anchor", label.anchor);
            text.textContent = label.name;
            return [ring, text];
          }),
        );
      }

      const percent = (score: number) => `${Math.round(score * 100)}\u202f%`;
      const VISIBLE_ROWS = 5;
      let showAll = false;

      function clone(id: string): HTMLElement {
        const template = document.getElementById(id) as HTMLTemplateElement;
        return template.content.firstElementChild!.cloneNode(true) as HTMLElement;
      }

      function setText(root: HTMLElement, selector: string, text: string) {
        (root.querySelector(selector) as HTMLElement).textContent = text;
      }

      function fillList(list: HTMLElement, items: string[]) {
        list.replaceChildren(
          ...items.map((text) => {
            const item = document.createElement("li");
            item.textContent = text;
            return item;
          }),
        );
      }

      function fillPortrait(box: HTMLElement, m: Match) {
        setText(box, ".portrait-title", `Pourquoi toi et ${m.city.name}`);
        (box.querySelector(".portrait") as HTMLElement).replaceChildren(
          ...m.portrait.map((line) => {
            const item = document.createElement("li");
            const said = document.createElement("span");
            said.className = "said";
            said.textContent = `Tu as dit · ${line.said}`;
            item.append(said, document.createTextNode(line.text));
            return item;
          }),
        );
      }

      // The same fields for every city, whether it is in the top three or further down.
      function detailFor(m: Match, withPortrait: boolean): HTMLElement {
        const body = clone("detail-template");
        const lines = linesFor(m.city.name);
        const show = (field: string, visible: boolean) => {
          (body.querySelector(`[data-field="${field}"]`) as HTMLElement).hidden = !visible;
        };
        show("portrait", withPortrait && m.portrait.length > 0);
        if (withPortrait) fillPortrait(body.querySelector('[data-field="portrait"]')!, m);
        show("reputation", Boolean(lines?.reputation));
        setText(body, '[data-field="reputation"] p', lines?.reputation ?? "");
        show("surprise", Boolean(lines?.surprise));
        setText(body, '[data-field="surprise"] p', lines?.surprise ?? "");
        const places = lines?.neighbourhoods ?? [];
        show("neighbourhoods", places.length > 0);
        (body.querySelector(".places") as HTMLElement).replaceChildren(
          ...places.map((place) => {
            const item = document.createElement("li");
            const name = document.createElement("b");
            name.textContent = place.name;
            item.append(name, document.createTextNode(` ${place.text}`));
            return item;
          }),
        );
        show("reasons", m.reasons.length > 0);
        fillList(body.querySelector(".reasons") as HTMLElement, m.reasons);
        setText(body, '[data-field="watch"] p', m.city.watch);
        (body.querySelector('[data-field="full"]') as HTMLAnchorElement).href =
          `/ville/${m.city.slug}`;
        return body;
      }

      function setBar(root: HTMLElement, score: number) {
        (root.querySelector(".bar > span") as HTMLElement).style.width =
          `${Math.round(score * 100)}%`;
      }

      function cardFor(m: Match, index: number): HTMLElement {
        const card = clone("card-template");
        if (index === 0) card.classList.add("first");
        setText(card, ".rank", String(index + 1));
        setText(card, ".card-name", m.city.name);
        setText(card, ".card-country", `${m.city.country} · ${m.city.languageLabel}`);
        setText(card, ".fit", percent(m.score));
        setBar(card, m.score);
        setText(card, ".card-tagline", m.city.tagline);
        setText(card, ".card-pitch", m.city.pitch);
        const photo = photoFor(m.city.name);
        if (index === 0 && photo) {
          const figure = card.querySelector(".photo") as HTMLElement;
          const image = figure.querySelector("img") as HTMLImageElement;
          image.src = `/photos/${photo.file}`;
          image.alt = photo.alt;
          setText(
            figure,
            "figcaption",
            `Photo : ${photo.author}, ${photo.license}, Wikimedia Commons`,
          );
          figure.hidden = false;
        }
        // The city in first place shows its "pourquoi toi" without a tap.
        const box = card.querySelector(".portrait-box") as HTMLElement;
        box.hidden = index !== 0 || m.portrait.length === 0;
        if (index === 0) fillPortrait(box, m);
        card.querySelector(".detail")!.append(detailFor(m, index !== 0));
        return card;
      }

      function rowFor(m: Match, position: number): HTMLElement {
        const row = clone(m.city.unsafe ? "unsafe-template" : "row-template");
        setText(row, ".rank", String(position));
        setText(row, ".row-name b", m.city.name);
        setText(row, ".row-country", `· ${m.city.country}`);
        if (m.city.unsafe) return row;
        setText(row, ".fit", percent(m.score));
        setText(row, ".row-tagline", m.city.tagline);
        setBar(row, m.score);
        row.querySelector(".detail")!.append(detailFor(m, true));
        return row;
      }

      function render() {
        const current = readAnswers();
        const answered = Object.values(current).some((value) => value !== undefined);
        const ranked = rankCities(current);
        // Filters only remove cities; the order stays the score's.
        const kept = applyFilters(ranked, filtersFrom(picked));
        const matches = kept.filter((m) => !m.city.unsafe && !m.excludedBecause).slice(0, 3);
        const scores = new Map(
          ranked
            .filter((m) => !m.city.unsafe)
            .map((m) => [m.city.name, m.score] as [string, number]),
        );
        // Before the first answer nothing is ranked yet: every dot stays the same and no city
        // is named, so the quiz does not look decided before it starts.
        // The map shows nothing before the first answer, colours every city by its score while the
        // reader answers, and names the top three only with the result.
        const count = Object.values(current).filter((value) => value !== undefined).length;
        const missing = answersBeforeLight(count);
        renderMap(revealed ? matches.map((m) => m.city.name) : [], missing ? new Map() : scores);
        (document.getElementById("legend") as HTMLElement).textContent = missing
          ? `Encore ${missing} ${missing > 1 ? "réponses" : "réponse"} avant que la carte s'allume.`
          : "Plus un point est chaud, plus la ville correspond à tes réponses. Les noms des trois premières apparaissent avec ton résultat.";

        (document.getElementById("results-hint") as HTMLElement).hidden = answered;
        (document.getElementById("results-sub") as HTMLElement).hidden = !answered;
        (document.getElementById("cards") as HTMLElement).replaceChildren(...matches.map(cardFor));

        // Every other city, in score order; conflict zones keep their place, greyed.
        const shown = new Set(matches.map((m) => m.city.name));
        const rest = kept.filter((m) => !shown.has(m.city.name));
        const removed = ranked.length - kept.length;
        (document.getElementById("filter-note") as HTMLElement).textContent = removed
          ? `${removed} ${removed > 1 ? "villes masquées" : "ville masquée"} par tes filtres. L'ordre ne change pas : seul ton score le décide.`
          : "Les filtres retirent des villes ; l'ordre ne change jamais.";
        (document.getElementById("others-hint") as HTMLElement).textContent = removed
          ? `Les ${kept.length} villes qui passent tes filtres, triées selon tes réponses.`
          : "Les 115 villes, triées selon tes réponses.";
        const visible = showAll ? rest : rest.slice(0, VISIBLE_ROWS);
        (document.getElementById("rows") as HTMLElement).replaceChildren(
          ...visible.map((m, i) => rowFor(m, i + 4)),
        );
        (document.getElementById("more") as HTMLElement).hidden = showAll;
      }

      document.getElementById("more")!.addEventListener("click", () => {
        showAll = true;
        render();
      });

      // One question at a time, chosen by what would reshuffle the top three the most; the quiz
      // settles after 8 to 12 answers (adaptive.ts, quiz mockup V2 of 2026-11-15).
      const fieldsets = new Map(
        [...form.querySelectorAll<HTMLFieldSetElement>(".question")].map((f) => [
          f.dataset.question as string,
          f,
        ]),
      );
      const asked: string[] = [];
      const tops: string[][] = [];
      let current: string | undefined = "project";
      let revealed = false;
      let refining = false;

      function showQuestion(id: string | undefined) {
        current = id;
        revealed = id === undefined;
        // On the phone the title gives way to the map once the reader has started.
        document.body.classList.toggle("started", asked.length > 0);
        fieldsets.forEach((fieldset, key) => (fieldset.hidden = key !== id));
        (document.getElementById("ready") as HTMLElement).hidden = id !== undefined;
        const filled = gauge(asked.length, id === undefined);
        (document.getElementById("counter") as HTMLElement).textContent =
          filled >= 1 ? "Prêt" : filled >= 0.6 ? "Presque" : "Ça se dessine";
        (document.getElementById("progress") as HTMLElement).style.width =
          `${Math.round(filled * 100)}%`;
        const back = id ? fieldsets.get(id)?.querySelector<HTMLButtonElement>(".back") : null;
        if (back) back.disabled = asked.length === 0;
        if (id)
          fieldsets.get(id)?.querySelector<HTMLElement>(".chip")?.focus({ preventScroll: true });
        render();
      }

      function advance() {
        if (current) {
          asked.push(current);
          tops.push(bestMatches(readAnswers(), 3).map((m) => m.city.name));
        }
        const next = nextFreeQuestion(readAnswers(), asked);
        const settled = !next || (!refining && isSettled(asked.length, tops));
        showQuestion(settled ? undefined : next);
      }

      function goBack() {
        const last = asked.pop();
        tops.pop();
        refining = false;
        if (last) showQuestion(last);
      }

      form.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        const move = target.closest<HTMLButtonElement>("[data-step]")?.dataset.step;
        if (move) {
          if (move === "back") goBack();
          else advance();
          return;
        }
        const chip = target.closest<HTMLButtonElement>(".chip");
        if (!chip) return;
        pick(chip);
        render();
        const fieldset = chip.closest<HTMLFieldSetElement>(".question");
        // A single-choice answer moves on by itself; several choices wait for « Valider ».
        if (Number(fieldset?.dataset.max) === 1 && chip.getAttribute("aria-pressed") === "true") {
          advance();
        }
      });

      document.getElementById("reveal")!.addEventListener("click", () => {
        const outcome = document.getElementById("outcome") as HTMLElement;
        outcome.hidden = false;
        outcome.scrollIntoView({ behavior: "smooth", block: "start" });
      });

      document.getElementById("refine")!.addEventListener("click", () => {
        refining = true;
        advance();
      });

      // Filters on the result: one sheet per filter, options toggled live.
      const picked: Partial<Record<keyof Filters, FilterOption["value"][]>> = {};
      const sheet = document.getElementById("filter-sheet") as HTMLDialogElement;

      function syncFilterChips() {
        for (const chip of document.querySelectorAll<HTMLButtonElement>(".filter-chip")) {
          const key = chip.dataset.filter as keyof Filters;
          chip.setAttribute("aria-pressed", String(Boolean(picked[key]?.length)));
        }
      }

      function openSheet(key: keyof Filters) {
        const entry = FILTER_MENU.find((f) => f.key === key)!;
        (document.getElementById("sheet-title") as HTMLElement).textContent = entry.label;
        (document.getElementById("sheet-hint") as HTMLElement).textContent = entry.hint;
        (document.getElementById("sheet-options") as HTMLElement).replaceChildren(
          ...entry.options.map((option) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "option";
            button.textContent = option.label;
            button.dataset.value = JSON.stringify(option.value);
            const on = () => (picked[key] ?? []).includes(option.value);
            button.setAttribute("aria-pressed", String(on()));
            button.addEventListener("click", () => {
              const values = picked[key] ?? [];
              picked[key] = on()
                ? values.filter((v) => v !== option.value)
                : entry.single
                  ? [option.value]
                  : [...values, option.value];
              for (const other of button.parentElement!.querySelectorAll<HTMLButtonElement>(
                ".option",
              ))
                other.setAttribute(
                  "aria-pressed",
                  String((picked[key] ?? []).includes(JSON.parse(other.dataset.value!))),
                );
              syncFilterChips();
              render();
            });
            return button;
          }),
        );
        sheet.showModal();
      }

      for (const chip of document.querySelectorAll<HTMLButtonElement>(".filter-chip")) {
        chip.addEventListener("click", () => openSheet(chip.dataset.filter as keyof Filters));
      }
      // A tap on the dimmed backdrop closes the sheet.
      sheet.addEventListener("click", (event) => {
        if (event.target === sheet) sheet.close();
      });

      showQuestion("project");
    </script>

