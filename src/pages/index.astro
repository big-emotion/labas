        cursor: pointer;
      }
      .sheet-options :global(.option[aria-pressed="true"]) {
        background: var(--night);
        border-color: var(--night);
        color: var(--thread);
      }
      .sheet .primary {
        min-height: 52px;
        border: 0;
        border-radius: 999px;
        background: var(--night);
        color: var(--thread);
        font-weight: 800;
        cursor: pointer;
      }
      .progress {
        display: grid;
        gap: 10px;
      }
      .stitches {
        display: flex;
        gap: 3px;
      }
      .stitches :global(i) {
        flex: 1;
        height: 4px;
        border-radius: 2px;
        background: var(--night-lift);
      }
      .stitches :global(i.done) {
        background: var(--saffron);
      }
      .counter {
        margin: 0;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--thread-dim);
      }
      .counter :global(b) {
        color: var(--saffron);
      }
      .question legend {
        font-size: clamp(1.6rem, 6vw, 2.2rem);
      }
      .steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
      }
      .back,
      .next,
      .primary,
      .secondary {
        min-height: 44px;
        border-radius: 999px;
        font-weight: 800;
        cursor: pointer;
      }
      .back {
        border: 0;
        background: transparent;
        color: var(--thread-dim);
        padding: 0 4px;
        font-weight: 400;
        text-decoration: underline;
        text-underline-offset: 4px;
      }
      .back[hidden] {
        visibility: hidden;
        display: inline;
      }
      .next:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .next,
      .primary {
        border: 0;
        background: var(--saffron);
        color: var(--ink);
        padding: 0 22px;
      }
      .ready {
        display: grid;
        gap: 12px;
        background: var(--night-deep);
        border: 2px solid var(--saffron);
        border-radius: 20px;
        padding: 22px;
      }
      .ready[hidden],
      .outcome[hidden] {
        display: none;
      }
      .ready h2 {
        margin: 0;
      }
      .ready p {
        margin: 0;
      }
      .primary {
        min-height: 54px;
        font-size: 1.05rem;
      }
      .secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        border: 2px solid var(--thread);
        background: transparent;
        color: var(--thread);
        text-decoration: none;
      }
      .outcome {
        display: grid;
        gap: 40px;
      }
      .further {
        display: grid;
        gap: 12px;
        background: var(--saffron);
        color: var(--ink);
        border-radius: 20px;
        padding: 24px;
      }
      .further h2 {
        margin: 0;
      }
      .further p {
        margin: 0;
      }
      .further a {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 52px;
        border-radius: 999px;
        background: var(--ink);
        color: var(--saffron);
        font-weight: 800;
        text-decoration: none;
      }
      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 18px;
      }
      .links a,
      :global(.detail-body .full) {
        color: var(--saffron);
        font-weight: 700;
      }
      .results :global(.photo) {
        margin: 0;
      }
      .results :global(.photo img) {
        width: 100%;
        height: auto;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        border-radius: 14px;
        display: block;
      }
      .results :global(.photo figcaption) {
        font-size: 0.75rem;
        color: var(--thread-dim);
        margin-top: 4px;
      }
      .footer {
        display: grid;
        gap: 6px;
        font-size: 0.82rem;
      }
      /* Result cards: same fields for each city, reasons rated 1 to 5. */
      .results :global(.card .fit) {
        text-align: right;
      }
      .results :global(.card .fit b) {
        display: block;
        font-size: 1.8rem;
        line-height: 1;
      }
      .results :global(.card .fit small) {
        display: block;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--thread-dim);
      }
      .results :global(.split),
      .results :global(.same) {
        margin: 0;
        font-size: 0.9rem;
        color: var(--thread-dim);
      }
      .results :global(.go:not([hidden])) {
        justify-self: start;
        display: inline-flex;
        align-items: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 999px;
        background: var(--saffron);
        color: var(--ink);
        font-weight: 700;
        text-decoration: none;
      }
      .results :global(.split b) {
        color: var(--thread);
      }
      .results :global(.rated h4) {
        margin: 0 0 6px;
        font-family: var(--font-body);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--thread-dim);
      }
      .results :global(.rated ul) {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 6px;
      }
      .results :global(.rated li) {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
      }
      .results :global(.rated[hidden]) {
        display: none;
      }
      .results :global(.pips) {
        display: inline-flex;
        gap: 3px;
        flex: none;
      }
      .results :global(.pips i) {
        width: 11px;
        height: 11px;
        border-radius: 3px;
        background: var(--night-lift);
      }
      .results :global(.pips i.on) {
        background: var(--saffron);
      }
      .results :global(.against .pips i.on) {
        background: var(--coral);
      }
      .results :global(.facts) {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 8px;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .results :global(.facts li) {
        background: var(--night-lift);
        border-radius: 999px;
        padding: 4px 11px;
        font-size: 0.82rem;
      }
      .temperament {
        background: var(--night-deep);
        border-radius: 20px;
        padding: 18px;
        display: grid;
        gap: 10px;
      }
      .temperament[hidden] {
        display: none;
      }
      .temperament p {
        margin: 0;
      }
      .archetype {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 2rem;
        line-height: 1;
        color: var(--saffron);
      }
      .traits {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 8px;
      }
      .traits :global(li) {
        display: grid;
        grid-template-columns: minmax(0, 10em) 1fr;
        gap: 10px;
        align-items: center;
        font-size: 0.92rem;
      }
      .traits :global(small) {
        display: block;
        color: var(--thread-dim);
        font-size: 0.78rem;
      }
      .traits :global(.meter) {
        height: 8px;
        border-radius: 4px;
        background: var(--night-lift);
        overflow: hidden;
      }
      .traits :global(.meter i) {
        display: block;
        height: 100%;
        background: var(--saffron);
      }
    </style>
  </body>
</html>
