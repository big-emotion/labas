---
import Page from "../layouts/Page.astro";
import { CITIES, ZONES, type Zone } from "../lib/cities";

/** Every city straight away, without the quiz (operator, 2026-11-18), by region then name. */
const byZone = (Object.keys(ZONES) as Zone[]).map((zone) => ({
  zone,
  label: ZONES[zone],
  cities: CITIES.filter((c) => c.zone === zone).sort((a, b) => a.name.localeCompare(b.name, "fr")),
}));
const enabled = Boolean(import.meta.env.PUBLIC_NEWSLETTER);
---

<Page
  title="Les villes"
  description={`Les ${CITIES.length} villes d'Afrique comparées par Là-bas, région par région, avec leur fiche.`}
>
  <h1>Les villes</h1>
  <p class="lead">
    Les {CITIES.length} villes que Là-bas compare, région par région. Chaque fiche donne les notes,
    leurs sources{enabled && ", et ce qu'en disent les lecteurs"}.
  </p>
  {enabled ? (
    <p>
      Pour les classer selon vos envies, <a href="/">faites le quiz</a> ou parcourez{" "}
      <a href="/avis/">les avis</a>.
    </p>
  ) : (
    <p>
      Pour les classer selon vos envies, <a href="/">faites le quiz</a>.
    </p>
  )}

  <nav class="jump" aria-label="Régions">
    {byZone.map(({ zone, label }) => (
      <a href={`#${zone}`}>{label}</a>
    ))}
  </nav>

  {byZone.map(({ zone, label, cities }) => (
    <section id={zone} aria-labelledby={`${zone}-title`}>
      <h2 id={`${zone}-title`}>{label}</h2>
      <ul class="cities">
        {cities.map((city) => (
          <li>
            <a href={`/ville/${city.slug}/`}>
              <b>{city.name}</b>
              <span class="country">{city.country}</span>
              <span class="tagline">{city.tagline}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Page>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--thread-faint);
    color: var(--thread);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }
  section {
    scroll-margin-top: 16px;
  }
  .cities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .cities li {
    max-width: none;
  }
  .cities a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--night-lift);
    color: var(--thread);
    text-decoration: none;
  }
  .cities a:hover,
  .cities a:focus-visible {
    background: var(--night-pressed);
  }
  .country {
    color: var(--thread-dim);
    font-size: 0.85rem;
    text-align: right;
  }
  .tagline {
    grid-column: 1 / -1;
    color: var(--thread-dim);
    font-size: 0.9rem;
  }
  @media (min-width: 768px) {
    .cities {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
