---
import Page from "../../layouts/Page.astro";

// Mirrors /mentions-legales: same build-time host settings, same facts. Prose pages keep one file
// per language rather than a dictionary, so each reads as written rather than assembled.
const hostName = import.meta.env.LEGAL_HOST_NAME?.trim();
const hostAddress = import.meta.env.LEGAL_HOST_ADDRESS?.trim();
const host = hostName
  ? `by ${hostAddress ? `${hostName}, ${hostAddress}` : hostName}`
  : "on servers run on the publisher's behalf";
---

