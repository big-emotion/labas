---
import { ADVICE_FRAMING } from "../../lib/advisory";
import Page from "../../layouts/Page.astro";
import { CITIES, CRITERIA, type City, type Confidence, type Source } from "../../lib/cities";
import { goingThere } from "../../lib/going";
import { linesFor } from "../../lib/lines";
import { photoFor } from "../../lib/photos";
import { routesFor } from "../../lib/routes";
import { costLabel } from "../../lib/card";
import { criteriaPreview } from "../../lib/city-sections";
import { holidayOf, monthNames } from "../../lib/holiday";

export function getStaticPaths() {
  return CITIES.map((city) => ({ params: { slug: city.slug }, props: { city } }));
}

interface Props {
  city: City;
}
const { city } = Astro.props;
const lines = linesFor(city.name);
const photo = photoFor(city.name);
// Unsafe cities get no route: the site never invites someone to go there.
const routes = routesFor(city.name);
const going = goingThere(city);
const country = city.countryFacts;
const advisory = city.facts.advisory;

const CONFIDENCE: Record<Confidence, string> = {
  measured: "Mesuré",
  survey: "Enquête",
  sourced: "Sourcé",
  editorial: "Estimation",
};
const COLOURS = {
  green: "vert (vigilance normale)",
  yellow: "jaune (vigilance renforcée)",
  orange: "orange (déconseillé sauf raison impérative)",
  red: "rouge (formellement déconseillé)",
};
const FCDO = {
  all: "déconseille tout voyage",
  "all-but-essential": "déconseille tout voyage sauf nécessité",
  none: "ne déconseille pas de s'y rendre",
};
const LANGUAGES = {
  fr: "français",
  en: "anglais",
  pt: "portugais",
  ar: "arabe",
  es: "espagnol",
  sw: "swahili",
};
const USE = {
  daily: "au quotidien",
  "work-and-admin": "au travail et dans les démarches",
  limited: "peu utilisé",
};
const SETTINGS = {
  ocean: "océan",
  "lake-or-river": "lac ou fleuve",
  mountains: "montagnes",
  forest: "forêt",
  savanna: "savane",
  desert: "désert",
  island: "une île",
};
const CLIMATES = {
  "hot-humid": "chaud et humide",
  "hot-dry": "chaud et sec",
  mild: "doux",
  highland: "frais en altitude",
};
const LGBT = {
  legal: "légales",
  criminalised: "punies par la loi",
  "criminalised-not-enforced": "punies par la loi, sans application connue",
  unclear: "situation juridique incertaine",
};
// Grouped by theme, each with a short preview (beta feedback, 2026-11-16).
const PREVIEW = 2;
const DAYS_SHOWN = 3;
const places = lines?.neighbourhoods ?? [];
const preview = criteriaPreview(city);
// Holiday facts, each sourced (operator, 2026-11-16): only shown when something is known.
const holidayData = holidayOf(city.name);
const holiday =
  holidayData &&
  (holidayData.activities.length || holidayData.bestMonths.length || holidayData.escapes.length)
    ? holidayData
    : undefined;
const ACTIVITY_NAMES = {
  safari: "Safari",
  desert: "Désert",
  diving: "Plongée",
  surf: "Surf",
  hiking: "Randonnée",
  watersports: "Sports nautiques",
  heritage: "Patrimoine",
  festival: "Festival",
};
const chips = [city.languageLabel, city.currency, costLabel(city.scores.cost.level)].filter(
  (chip): chip is string => Boolean(chip),
);
const themes = [
  { id: "essentiel", label: "L'essentiel" },
  ...(places.length ? [{ id: "quartiers", label: "Quartiers" }] : []),
  ...(routes
    ? [
        { id: "semaine", label: "Votre semaine" },
        { id: "decouvrir", label: "Découvrir" },
      ]
    : []),
  ...(holiday ? [{ id: "vacances", label: "En vacances" }] : []),
  { id: "criteres", label: "Critères" },
  ...(country ? [{ id: "pays", label: "Le pays" }] : []),
  ...(going ? [{ id: "y-aller", label: "Y aller" }] : []),
];
const sourceLabel = (s: Source) => `${s.title}${s.published ? `, ${s.published}` : ""}`;
---

<Page
  title={`Vivre à ${city.name}, ${city.country}`}
  description={`${city.name} (${city.country}) : ${city.tagline}. Ce qu'il faut savoir pour y vivre, critère par critère, avec nos sources.`}
>
  <article class="city">
    <header class="hero">
      <p class="eyebrow">{city.country}</p>
      <h1>{city.name}</h1>
      <p class="tagline">{city.tagline}</p>
      {photo && (
        <figure class="photo">
          <img
            src={`/photos/${photo.file}`}
            alt={photo.alt}
            width="1280"
            height="853"
            loading="eager"
          />
          <figcaption>
            Photo : {photo.author}, <a href={photo.licenseUrl}>{photo.license}</a>, via{" "}
            <a href={photo.source}>Wikimedia Commons</a>.
          </figcaption>
        </figure>
      )}
      <p>{city.pitch}</p>
      <ul class="chips">
        {chips.map((chip) => (
          <li>{chip}</li>
        ))}
      </ul>
    </header>

    <nav class="themes" aria-label="Thèmes de la fiche">
      {themes.map((theme) => (
        <a href={`#${theme.id}`}>{theme.label}</a>
      ))}
    </nav>

    <section class="theme" id="essentiel">
      <h2>L'essentiel</h2>
      {lines?.reputation && (
        <p>
          <b>On dit</b> <span class="quote">{lines.reputation}</span>
        </p>
      )}
      {lines?.surprise && (
        <p>
          <b>Ce qui pourrait vous surprendre :</b> {lines.surprise}
        </p>
      )}
      <p class="watch">
        <b>À savoir :</b> {city.watch}
      </p>
      <p>
        <b>Conseils aux voyageurs :</b>{" "}
        {advisory.franceDiplomatie
          ? `France Diplomatie : zone ${COLOURS[advisory.franceDiplomatie]}. `
          : "France Diplomatie : couleur de la zone non trouvée. "}
        {advisory.fcdo && `Le Royaume-Uni ${FCDO[advisory.fcdo]}. `}
        {advisory.date && `Avis du ${advisory.date}. `}
        Vérifiez toujours la page du ministère avant de partir.
      </p>
      {city.advisedAgainst && <p>{ADVICE_FRAMING}</p>}
      <p class="small">
        {advisory.sources.map((source, i) => (
          <>
            {i > 0 && " ; "}
            <a href={source.url} rel="noopener noreferrer">
              {sourceLabel(source)}
            </a>
          </>
        ))}
      </p>
      <details>
        <summary>
          <span class="when-closed">Langues, climat et alentours</span>
          <span class="when-open">Masquer</span>
        </summary>
        <ul class="facts">
          <li>
            <b>Langues :</b>{" "}
            {city.facts.languages.map((l) => `${LANGUAGES[l.language]} ${USE[l.use]}`).join(", ") ||
              city.languageLabel}
          </li>
          {city.facts.climates.length > 0 && (
            <li>
              <b>Climat :</b> {city.facts.climates.map((c) => CLIMATES[c]).join(", ")}
            </li>
          )}
          {city.facts.settings.length > 0 && (
            <li>
              <b>Autour :</b> {city.facts.settings.map((s) => SETTINGS[s]).join(", ")}
            </li>
          )}
          <li>
            <b>Monnaie :</b> {city.currency}
          </li>
        </ul>
      </details>
    </section>

    {places.length > 0 && (
      <section class="theme" id="quartiers">
        <h2>Les quartiers</h2>
        <ul class="places">
          {places.slice(0, PREVIEW).map((place) => (
            <li>
              <b>{place.name}</b> {place.text}
            </li>
          ))}
        </ul>
        {places.length > PREVIEW && (
          <details>
            <summary>
              <span class="when-closed">Voir les {places.length} quartiers</span>
              <span class="when-open">Masquer</span>
            </summary>
            <ul class="places">
              {places.slice(PREVIEW).map((place) => (
                <li>
                  <b>{place.name}</b> {place.text}
                </li>
              ))}
            </ul>
          </details>
        )}
        <p class="small">Loyers affichés, souvent négociables.</p>
      </section>
    )}

    {routes && (
      <section class="theme" id="semaine">
        <h2>Votre semaine type</h2>
        <p class="small">
          Des lieux réels, tirés de nos sources. Celle qui vous ressemble s'ouvre d'après vos
          réponses ; les autres sont à un clic.
        </p>
        <div class="week-tabs" role="group" aria-label="Choisir une semaine">
          {routes.weeks.map((week, i) => (
            <button type="button" data-week={i} aria-pressed={i === 0 ? "true" : "false"}>
              {week.title}
            </button>
          ))}
        </div>
        {routes.weeks.map((week, i) => (
          <div class="week" data-week-panel={i} hidden={i !== 0}>
            <p class="small">
              Point de départ : {week.base}
              {week.budget && ` · ${week.budget}`}
            </p>
            <ul class="days">
              {week.days.slice(0, DAYS_SHOWN).map((day) => (
                <li>{day}</li>
              ))}
            </ul>
            <details>
              <summary>
                <span class="when-closed">Voir toute la semaine</span>
                <span class="when-open">Masquer</span>
              </summary>
              <ul class="days">
                {week.days.slice(DAYS_SHOWN).map((day) => (
                  <li>{day}</li>
                ))}
              </ul>
            </details>
          </div>
        ))}
        <script
          type="application/json"
          id="week-keys"
          set:html={JSON.stringify(routes.weeks.map((week) => ({ for: week.for })))}
        />
      </section>
    )}

    {routes && (
      <section class="theme" id="decouvrir">
        <h2>Pour découvrir d'abord</h2>
        <p class="small">Une journée :</p>
        <ul class="days">
          {routes.discovery.day.map((moment) => (
            <li>{moment}</li>
          ))}
        </ul>
        <details>
          <summary>
            <span class="when-closed">Voir la semaine découverte</span>
            <span class="when-open">Masquer</span>
          </summary>
          <ul class="days">
            {routes.discovery.week.map((day) => (
              <li>{day}</li>
            ))}
          </ul>
        </details>
        <p class="small">
          Sources :{" "}
          {routes.sources.map((source, i) => (
            <>
              {i > 0 && " ; "}
              <a href={source.url} rel="noopener noreferrer">
                {source.title}
              </a>
            </>
          ))}
        </p>
      </section>
    )}

    {holiday && (
      <section class="theme" id="vacances">
        <h2>En vacances</h2>
        {holiday.bestMonths.length > 0 && (
          <p>
            <b>La belle saison :</b> {monthNames(holiday.bestMonths)}.
            {holiday.rainyMonths.length > 0 && ` Les pluies : ${monthNames(holiday.rainyMonths)}.`}
            {holiday.monthsSource && (
              <>
                {" "}
                <a class="small" href={holiday.monthsSource.url} rel="noopener noreferrer">
                  Source
                </a>
              </>
            )}
          </p>
        )}
        {holiday.activities.length > 0 && (
          <ul class="facts">
            {holiday.activities.map((activity) => (
              <li>
                <b>{ACTIVITY_NAMES[activity.tag]} :</b> {activity.where}
                {activity.distance && `, ${activity.distance}`} (
                <a href={activity.source.url} rel="noopener noreferrer">
                  source
                </a>
                )
              </li>
            ))}
          </ul>
        )}
        {holiday.escapes.length > 0 && (
          <details>
            <summary>
              <span class="when-closed">Les escapades à faire</span>
              <span class="when-open">Masquer</span>
            </summary>
            <ul class="facts">
              {holiday.escapes.map((escape) => (
                <li>
                  <b>{escape.name}</b> · {escape.what}
                  {escape.distance && `, ${escape.distance}`} (
                  <a href={escape.source.url} rel="noopener noreferrer">
                    source
                  </a>
                  )
                </li>
              ))}
            </ul>
          </details>
        )}
      </section>
    )}

    <section class="theme" id="criteres">
      <h2>La ville, critère par critère</h2>
      <ul class="preview">
        {preview.strongest.map((criterion) => (
          <li>
            <span>{criterion.label}</span>
            <span class="level">{city.scores[criterion.key].level}/5</span>
          </li>
        ))}
        {preview.weakest && (
          <li class="weak">
            <span>{preview.weakest.label}</span>
            <span class="level">{city.scores[preview.weakest.key].level}/5</span>
          </li>
        )}
      </ul>
      <details>
        <summary>
          <span class="when-closed">Voir les {CRITERIA.length} critères et leurs sources</span>
          <span class="when-open">Masquer</span>
        </summary>
        <p class="small">
          Notes de 0 à 5 selon <a href="/methode">notre grille</a>. Pour les critères marqués «
          cible », une note haute n'est ni bonne ni mauvaise : on la compare à ce que vous cherchez.
        </p>
        <ul class="scores">
          {CRITERIA.map((criterion) => {
            const score = city.scores[criterion.key];
            return (
              <li class="score">
                <div class="score-head">
                  <a href={`/methode#${criterion.key}`} class="score-name">
                    {criterion.label}
                  </a>
                  {criterion.direction === "target" && <span class="tag">cible</span>}
                  <span class="level">{score.level === null ? "?" : `${score.level}/5`}</span>
                </div>
                <span class="bar">
                  <span style={`width: ${((score.level ?? 0) / 5) * 100}%`} />
                </span>
                <p>{score.justification}</p>
                <p class="small">
                  {score.level === null ? "Inconnu" : CONFIDENCE[score.confidence]}
                  {score.sources.length > 0 && " · "}
                  {score.sources.map((source, i) => (
                    <>
                      {i > 0 && " ; "}
                      <a href={source.url} rel="noopener noreferrer">
                        {sourceLabel(source)}
                      </a>
                    </>
                  ))}
                </p>
              </li>
            );
          })}
        </ul>
      </details>
    </section>

    {country && (
      <section class="theme" id="pays">
        <h2>Le pays : {country.name}</h2>
        <ul class="facts">
          <li>
            <b>Entrer avec un passeport français :</b>{" "}
            {country.visaFreeDaysFrenchPassport
              ? `sans visa jusqu'à ${country.visaFreeDaysFrenchPassport} jours. `
              : "visa nécessaire. "}
            {country.visaNote}
          </li>
          <li>
            <b>Pour la diaspora :</b> {country.diasporaRoute}
          </li>
        </ul>
        <details>
          <summary>
            <span class="when-closed">Voir plus sur le pays</span>
            <span class="when-open">Masquer</span>
          </summary>
          <ul class="facts">
            <li>
              <b>Démarches :</b> {country.paperwork.justification}
            </li>
            {country.dualNationality.note && (
              <li>
                <b>Double nationalité :</b> {country.dualNationality.note}
              </li>
            )}
            {country.mobileMoney && (
              <li>
                <b>Payer :</b> {country.mobileMoney}
              </li>
            )}
            {country.sameSexRelations.status && (
              <li>
                <b>Relations entre personnes de même sexe :</b>{" "}
                {LGBT[country.sameSexRelations.status]}. {country.sameSexRelations.note}
              </li>
            )}
            {country.described.returneePerception && (
              <li>
                <b>Le regard sur ceux qui reviennent :</b> {country.described.returneePerception}
              </li>
            )}
            {country.described.womenDaily && (
              <li>
                <b>Le quotidien des femmes :</b> {country.described.womenDaily}
              </li>
            )}
          </ul>
        </details>
      </section>
    )}

    {going && (
      <section class="theme" id="y-aller">
        <h2>Y aller</h2>
        <ul>
          {going.map((link) => (
            <li>
              <a href={link.url} rel="noopener noreferrer">
                {link.title}
              </a>
            </li>
          ))}
        </ul>
        <p class="small">
          Ces liens mènent vers d'autres sites. Là-bas ne touche aucune commission.
        </p>
      </section>
    )}

    {lines && lines.sources.length > 0 && (
      <details class="small">
        <summary>Sources des textes de cette page</summary>
        <ul>
          {lines.sources.map((source) => (
            <li>
              <a href={source.url} rel="noopener noreferrer">
                {sourceLabel(source)}
              </a>
              , consulté le {source.accessed}
            </li>
          ))}
        </ul>
      </details>
    )}
  </article>
</Page>

<script>
  import { browserStore } from "../../lib/keep-dom";
  import { loadAnswers } from "../../lib/keep";
  import { bestWeekIndex } from "../../lib/week-pick";

  const keys = document.getElementById("week-keys");
  if (keys) {
    const weeks = JSON.parse(keys.textContent ?? "[]");
    const show = (index: number) => {
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-week]"))
        button.setAttribute("aria-pressed", String(Number(button.dataset.week) === index));
      for (const panel of document.querySelectorAll<HTMLElement>("[data-week-panel]"))
        panel.hidden = Number(panel.dataset.weekPanel) !== index;
    };
    show(bestWeekIndex(weeks, loadAnswers(browserStore())));
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-week]"))
      button.addEventListener("click", () => show(Number(button.dataset.week)));
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 10px;
  }
  .hero p {
    margin: 0;
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
  }
  .chips li {
    padding: 4px 11px;
    border-radius: 999px;
    background: var(--night-lift);
    font-size: 0.82rem;
  }
  /* Shortcuts to each theme: one row that scrolls sideways on a phone. */
  .themes {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .themes a {
    flex: none;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border-radius: 999px;
    border: 2px solid var(--night-lift);
    color: var(--thread);
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
  }
  .themes a:first-child {
    background: var(--saffron);
    border-color: var(--saffron);
    color: var(--ink);
  }
  .theme {
    background: var(--night-deep);
    border-radius: 18px;
    padding: 18px;
    display: grid;
    gap: 12px;
    scroll-margin-top: 12px;
  }
  .theme h2 {
    margin: 0;
  }
  .theme p {
    margin: 0;
  }
  .theme details > summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--saffron);
    font-weight: 700;
    list-style: none;
  }
  .theme details > summary::-webkit-details-marker {
    display: none;
  }
  .theme details[open] .when-closed,
  .theme details:not([open]) .when-open {
    display: none;
  }
  .theme .places li,
  .theme .score {
    background: var(--night);
  }
  .watch b {
    color: var(--coral);
  }
  .week-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .week-tabs button {
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    border: 2px solid var(--night-lift);
    background: transparent;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
  }
  .week-tabs button[aria-pressed="true"] {
    border-color: var(--saffron);
    background: var(--night-pressed);
  }
  .week {
    display: grid;
    gap: 8px;
  }
  .week[hidden] {
    display: none;
  }
  .preview {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .preview li {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .preview .weak .level {
    color: var(--coral);
  }
  .route {
    background: var(--night-deep);
    border-radius: 12px;
    padding: 10px 14px;
    margin-top: 8px;
  }
  .route summary {
    cursor: pointer;
    font-weight: 700;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .days {
    margin: 6px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  .city {
    display: grid;
    gap: 18px;
  }
  .city h1 {
    margin: 0;
  }
  .city section h2 {
    margin-top: 8px;
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--saffron);
  }
  .tagline {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--saffron);
  }
  .photo {
    margin: 0;
  }
  .photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 16px;
    display: block;
  }
  .photo figcaption,
  .small {
    font-size: 0.8rem;
    color: var(--thread-dim);
    margin: 6px 0 0;
  }
  /* Each way there is a tap target of at least 44px on a phone. */
  #y-aller li a {
    display: inline-block;
    padding: 10px 0;
  }
  .quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.35;
    margin: 4px 0 0;
  }
  .watch {
    border: 2px solid var(--coral);
    border-radius: 14px;
    padding: 4px 14px 12px;
  }
  .watch h2 {
    color: var(--coral);
  }
  .places,
  .scores,
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .places li,
  .score {
    background: var(--night-deep);
    border-radius: 12px;
    padding: 10px 14px;
  }
  .score p {
    margin: 6px 0 0;
  }
  .score-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .score-name {
    font-weight: 800;
    color: var(--thread) !important;
    text-decoration: none;
    flex-grow: 1;
