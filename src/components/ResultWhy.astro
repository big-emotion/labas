---
/**
 * « Pourquoi ces villes ? » sits above the result cards, folded (beta feedback, 2026-11-19):
 * readers surprised by their top three had to open a card to find a reason, but the unfolded box
 * pushed the first city a screen down, so only its question shows until it is tapped.
 * Filled by showWhy() in lib/why-dom.ts.
 */
import type { Bilingual } from "../i18n/locale";
import { localeOfPath } from "../i18n/routes";

const COPY: Bilingual<Record<string, string>> = {
  fr: {
    title: "Pourquoi ces villes ?",
    how: "Chaque réponse rapproche les villes qui vous ressemblent. Aucune ville n'est retirée.",
    yours: "Ce que vous nous avez dit",
    shared: "Ce que ces villes ont en commun",
    toKnow: "À savoir",
  },
  en: {
    title: "Why these cities?",
    how: "Each answer brings the cities that are like you closer. No city is removed.",
    yours: "What you told us",
    shared: "What these cities have in common",
    toKnow: "Good to know",
  },
};
const copy = COPY[localeOfPath(Astro.url.pathname)];
---

<details class="why-box" data-why hidden>
  <summary>{copy.title}</summary>
  <div class="why-body">
    <p class="why-how">{copy.how}</p>
    <div class="why-yours" data-why-yours hidden>
      <p class="why-label">{copy.yours}</p>
      <ul></ul>
      <p class="why-closer" data-why-closer hidden></p>
    </div>
    <div class="why-reasons">
      <div data-why-shared>
        <p class="why-label">{copy.shared}</p>
        <ul></ul>
      </div>
      <div data-why-first>
        <p class="why-label" data-why-first-title></p>
        <ul></ul>
        <p class="why-know" data-why-know hidden>
          <b>{copy.toKnow}</b>
          <span></span>
        </p>
      </div>
    </div>
  </div>
</details>

<style>
  .why-box {
    background: var(--night-lift);
    border-radius: 16px;
  }
  .why-box[hidden] {
    display: none;
  }
  .why-box p,
  .why-box ul {
    margin: 0;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 52px;
    padding: 0 18px;
    font-weight: 800;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--saffron);
  }
  .why-box[open] summary::after {
    content: "−";
  }
  .why-body {
    display: grid;
    gap: 12px;
    padding: 0 18px 18px;
  }
  .why-how {
    color: var(--thread-dim);
    font-size: 0.9rem;
  }
  .why-reasons {
    display: grid;
    gap: 12px;
  }
  .why-reasons > div {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .why-yours {
    display: grid;
    gap: 6px;
  }
  .why-yours ul {
    padding-left: 1.1em;
    display: grid;
    gap: 2px;
    font-size: 0.95rem;
  }
  .why-closer {
    color: var(--saffron);
    font-size: 0.95rem;
  }
  .why-yours[hidden],
  .why-closer[hidden],
  .why-reasons > div[hidden],
  .why-know[hidden] {
    display: none;
  }
  .why-label {
    font-weight: 800;
  }
  .why-reasons ul {
    padding-left: 1.1em;
    display: grid;
    gap: 2px;
    font-size: 0.95rem;
  }
  .why-know {
    font-size: 0.9rem;
    color: var(--thread-dim);
  }
  .why-know b {
    margin-right: 6px;
  }
  @media (min-width: 768px) {
    .why-reasons {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }
</style>
