---
/**
 * « Recevoir les nouveautés » (approved mockup, 2026-11-16): in the quiz after the fourth answer,
 * once per visit, and always on the result. Built only when PUBLIC_NEWSLETTER is set, that is
 * once the subscribe service has its mail settings (docs/deploy.md).
 */
import { BRAND, type Bilingual } from "../i18n/locale";
import { localeOfPath, pathFor } from "../i18n/routes";

interface Props {
  place: "quiz" | "results";
}
const { place } = Astro.props;
const enabled = Boolean(import.meta.env.PUBLIC_NEWSLETTER);
const id = `news-${place}`;
const locale = localeOfPath(Astro.url.pathname);
const COPY = {
  fr: {
    quizTitle: "Recevoir les nouveautés ?",
    resultsTitle: `Suivre ${BRAND.fr}`,
    quizLead:
      "Nouvelles villes, questionnaire amélioré : un e-mail par mois au plus. Vous pouvez aussi finir le quiz d'abord.",
    resultsLead:
      "Nouvelles villes, nouvelles questions, classement affiné : un e-mail par mois au plus pour vous dire ce qui change.",
    email: "Votre e-mail",
    emailPlaceholder: "vous@exemple.fr",
    website: "Site web",
    consent: `Je veux recevoir les nouveautés de ${BRAND.fr} par e-mail.`,
    signUp: "M'inscrire",
    later: "Plus tard",
    small:
      "Vous confirmerez par un lien reçu par e-mail. Désinscription en un clic. Nous gardons votre adresse, rien d'autre : vos réponses au quiz ne sont jamais envoyées.",
    privacy: "Confidentialité",
    checkInbox: "Regardez votre boîte e-mail",
    wroteTo: "Nous venons d'écrire à",
    clickLink: ". Cliquez sur le lien de ce message pour confirmer votre inscription.",
    noConfirm:
      "Sans confirmation, vous ne recevrez rien. Rien reçu d'ici quelques minutes ? Regardez dans les indésirables.",
  },
  en: {
    quizTitle: "Get the news?",
    resultsTitle: `Follow ${BRAND.en}`,
    quizLead:
      "New cities, a better questionnaire: one email a month at most. You can also finish the quiz first.",
    resultsLead:
      "New cities, new questions, a finer ranking: one email a month at most to tell you what changes.",
    email: "Your email",
    emailPlaceholder: "you@example.com",
    website: "Website",
    consent: `I want to receive ${BRAND.en} news by email.`,
    signUp: "Sign me up",
    later: "Later",
    small:
      "You'll confirm with a link sent by email. Unsubscribe in one click. We keep your address, nothing else: your quiz answers are never sent.",
    privacy: "Privacy",
    checkInbox: "Check your inbox",
    wroteTo: "We have just written to",
    clickLink: ". Click the link in that message to confirm your sign-up.",
    noConfirm:
      "Without confirming, you won't receive anything. Nothing within a few minutes? Look in your spam folder.",
  },
} satisfies Bilingual<Record<string, string>>;
const copy = COPY[locale];
---

{enabled && (
  <section
    class:list={["news", place]}
    data-news={place}
    aria-labelledby={`${id}-title`}
    hidden={place === "quiz"}
  >
    <div data-news-form>
      <h2 id={`${id}-title`}>{place === "quiz" ? copy.quizTitle : copy.resultsTitle}</h2>
      <p class="lead">{place === "quiz" ? copy.quizLead : copy.resultsLead}</p>
      <form novalidate>
        <label class="field">
          {copy.email}
          <input
            type="email"
            name="email"
            placeholder={copy.emailPlaceholder}
            autocomplete="email"
            required
          />
        </label>
        <label class="trap" aria-hidden="true">
          {copy.website}
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
        <label class="consent">
          <input type="checkbox" name="consent" />
          <span>{copy.consent}</span>
        </label>
        <p class="error" data-news-error role="alert" hidden></p>
        <div class="actions">
          <button type="submit" class="primary">
            {copy.signUp}
          </button>
          {place === "quiz" && (
            <button type="button" class="later" data-news-later>
              {copy.later}
            </button>
          )}
        </div>
      </form>
      <p class="small">
        {copy.small} <a href={pathFor("privacy", locale)}>{copy.privacy}</a>
      </p>
    </div>
    <div class="sent" data-news-sent role="status" hidden>
      <h2>{copy.checkInbox}</h2>
      <p>
        {copy.wroteTo} <b data-news-address />
        {copy.clickLink}
      </p>
      <p class="small">{copy.noConfirm}</p>
    </div>
  </section>
)}

<script>
  import { pageLocale } from "../i18n/locale";
  import { outcomeOf, shouldOfferNews, signUpBody } from "../lib/newsletter";

  const locale = pageLocale();

  const DISMISSED = "labas.news.later";
  const dismissed = () => {
    try {
      return sessionStorage.getItem(DISMISSED) === "1";
    } catch {
      return false;
    }
  };

  for (const block of document.querySelectorAll<HTMLElement>("[data-news]")) {
    const form = block.querySelector("form")!;
    const error = block.querySelector<HTMLElement>("[data-news-error]")!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    if (block.dataset.news === "quiz") {
      // index.astro announces how many questions are answered; the block shows from the fourth.
      document.addEventListener("labas:answered", (event) => {
        const answered = (event as CustomEvent<number>).detail;
        if (!block.querySelector<HTMLElement>("[data-news-sent]")!.hidden) return;
        block.hidden = !shouldOfferNews(answered, dismissed());
      });
      block.querySelector("[data-news-later]")?.addEventListener("click", () => {
        try {
          sessionStorage.setItem(DISMISSED, "1");
        } catch {
          // Blocked storage: the block still closes for now.
        }
        block.hidden = true;
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const body = signUpBody(
        {
          email: String(data.get("email") ?? ""),
          consent: data.get("consent") === "on",
          website: String(data.get("website") ?? ""),
        },
        locale,
      );
      const show = (message: string) => {
        error.textContent = message;
        error.hidden = false;
      };
      if (!body) {
        const outcome = outcomeOf(400, "news", locale);
        if (!outcome.sent) show(outcome.message);
        return;
      }
      submit.disabled = true;
      let status: number;
      try {
        const response = await fetch("/api/nouveautes", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });
        status = response.status;
      } catch {
        status = 0;
      }
      submit.disabled = false;
      const outcome = outcomeOf(status, "news", locale);
      if (!outcome.sent) return show(outcome.message);
      block.querySelector<HTMLElement>("[data-news-address]")!.textContent = body.email;
      block.querySelector<HTMLElement>("[data-news-form]")!.hidden = true;
      block.querySelector<HTMLElement>("[data-news-sent]")!.hidden = false;
    });
  }
</script>

<style>
  .news {
    display: grid;
    gap: 12px;
    background: var(--night-deep);
    border: 1px solid var(--night-lift);
    border-radius: 18px;
    padding: 18px;
  }
  .news.results {
    border-radius: 20px;
    padding: 22px;
  }
  .news:has(.sent:not([hidden])) {
    border: 2px solid var(--saffron);
  }
  [data-news-form],
  .sent,
  form {
    display: grid;
    gap: 12px;
    margin: 0;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.15;
  }
  .results h2,
  .sent h2 {
    font-size: 1.6rem;
  }
  p {
    margin: 0;
  }
  .lead,
  .small {
    color: var(--thread-dim);
    font-size: 0.92rem;
  }
  .small {
    font-size: 0.82rem;
  }
  .small a {
    color: var(--saffron);
  }
  .field {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  input[type="email"] {
    min-height: 48px;
    box-sizing: border-box;
    border-radius: 14px;
    border: 2px solid var(--thread-dim);
    background: var(--night);
    color: var(--thread);
    padding: 0 14px;
    font: inherit;
    font-weight: 400;
  }
  .consent {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .consent input {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--saffron);
  }
  /* Off screen rather than display:none, which some robots skip. */
  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .error {
    color: var(--coral);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .primary {
    min-height: 48px;
    border: 0;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font-weight: 800;
    padding: 0 22px;
    cursor: pointer;
  }
  .results .primary {
    min-height: 54px;
    flex: 1;
    font-size: 1.05rem;
  }
  .primary:disabled {
    opacity: 0.4;
  }
  .later {
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--thread-dim);
    text-decoration: underline;
    text-underline-offset: 4px;
    padding: 0 4px;
    cursor: pointer;
  }
  /* Last, and more specific than the display rules above, so hidden parts really hide. */
  .news[hidden],
  .news [hidden] {
    display: none;
  }
</style>
