---
/**
 * Reactions on a city (operator, 2026-11-18): the whole thread on the city page, a preview of the
 * first city on every result page. Reactions are what the operator wants to learn from, so the
 * block sits high and on a light background that stands out from the night-blue page.
 * Rendered by lib/reactions-dom.ts; hidden when the accounts service does not answer.
 */
import { BRAND, type Bilingual } from "../i18n/locale";
import { cityName } from "../i18n/places";
import { localeOfPath, pathFor } from "../i18n/routes";
import { ofCity } from "../lib/reactions";

interface Props {
  /** Known on the city page; on a result page the script fills in the first city. */
  city?: { slug: string; name: string };
  preview?: boolean;
  /** /avis: the reviews of every city, mounted by that page with its filters. */
  everywhere?: boolean;
}
const { city, preview = false, everywhere = false } = Astro.props;
const enabled = Boolean(import.meta.env.PUBLIC_NEWSLETTER);
const titleId = preview ? "reactions-preview-title" : "reactions-title";
const mode = everywhere ? "everywhere" : preview ? "preview" : "thread";
const locale = localeOfPath(Astro.url.pathname);
const name = city ? cityName(city.name, locale) : "";

const COPY = {
  fr: {
    latest: "Les derniers avis",
    saying: "Ce qu'on dit",
    of: city ? ofCity(name) : "",
    emptyEverywhere:
      "Aucun avis ne correspond. Essayez un autre mot, une autre région, ou retirez un filtre.",
    emptyBefore: "Personne n'a encore rien partagé. Vous connaissez",
    emptyAfter: " ? Laissez la première information utile pour les prochains.",
    moreEverywhere: "Voir plus d'avis",
    more: "Voir plus de réactions",
    react: "Laisser une info utile",
    all: "Voir toutes les réactions",
    openInReviews: "Ouvrir dans l'espace avis",
    yourReaction: "Votre information",
    starters: "Pour commencer",
    textHint:
      "Un quartier, un prix, une démarche, ce qui vous a surpris : ce qui aidera la personne qui prépare son départ. 1 000 caractères au plus.",
    shownName: "Nom affiché",
    optional: "(facultatif)",
    nameHint:
      "Sinon, « Utilisateur » et un numéro. Les réactions sont publiques : évitez votre nom complet.",
    private: "Ne pas rendre public mon top 3 ni mon profil de personnalité",
    privateHint:
      "Sans cette case, ils s'affichent sous votre réaction : vos trois villes avec leurs pourcentages, et votre façon de vivre. Jamais vos réponses.",
    email: "Votre e-mail",
    emailPlaceholder: "vous@exemple.fr",
    review:
      "Pas besoin d'e-mail : l'équipe relit chaque message avant de le mettre en ligne. Connecté à votre espace, il est publié tout de suite.",
    website: "Site web",
    send: "Envoyer",
    privacy: "Confidentialité",
    readMore: "Lire la suite",
    translate: "Traduire",
    journeyTitle: `Son parcours sur ${BRAND.fr}`,
    temperament: "Façon de vivre",
    bigFive: "Inspiré du Big Five, ce n'est pas un test de personnalité.",
    reply: "Répondre",
    report: "Signaler",
    remove: "Supprimer",
    yourReply: "Votre réponse",
    sendReply: "Envoyer la réponse",
    login: "Pour réagir, connectez-vous : nous vous envoyons un lien par e-mail.",
    getLink: "Recevoir le lien",
    loginDone:
      "Si un espace existe pour cette adresse, le lien arrive dans quelques minutes. Pas encore d'espace ? « Recevoir par e-mail », sous un résultat, en ouvre un.",
  },
  en: {
    latest: "The latest reviews",
    saying: "What people say about",
    of: name,
    emptyEverywhere: "No review matches. Try another word, another region, or remove a filter.",
    emptyBefore: "Nobody has shared anything yet. Do you know",
    emptyAfter: "? Leave the first useful word for the next person.",
    moreEverywhere: "See more reviews",
    more: "See more reactions",
    react: "Share something useful",
    all: "See all reactions",
    openInReviews: "Open in the reviews section",
    yourReaction: "What you know",
    starters: "To start",
    textHint:
      "A neighbourhood, a price, a formality, what surprised you: whatever will help someone preparing to move. 1,000 characters at most.",
    shownName: "Display name",
    optional: "(optional)",
    nameHint: "Otherwise, “User” and a number. Reactions are public: avoid your full name.",
    private: "Do not make my top 3 or my personality profile public",
    privateHint:
      "Without this box, they show under your reaction: your three cities with their percentages, and your way of living. Never your answers.",
    email: "Your email",
    emailPlaceholder: "you@example.com",
    review:
      "No email needed: the team reads every message before it goes online. Signed in to your space, it is published straight away.",
    website: "Website",
    send: "Send",
    privacy: "Privacy",
    readMore: "Read more",
    translate: "Translate",
    journeyTitle: `Their journey on ${BRAND.en}`,
    temperament: "Way of living",
    bigFive: "Inspired by the Big Five; it is not a personality test.",
    reply: "Reply",
    report: "Report",
    remove: "Delete",
    yourReply: "Your reply",
    sendReply: "Send the reply",
    login: "To react, sign in: we send you a link by email.",
    getLink: "Get the link",
    loginDone:
      "If a space exists for this address, the link arrives within a few minutes. No space yet? “Get it by email”, under a result, opens one.",
  },
} satisfies Bilingual<Record<string, string>>;
const copy = COPY[locale];
// A tap starts the text (operator, 2026-11-22): a blank box stops a reader who knows the city.
const STARTERS: Bilingual<string[]> = {
  fr: ["Quartier à conseiller : ", "Coût de la vie : ", "Ce qui m'a surpris : ", "J'y vis : "],
  en: [
    "A neighbourhood to recommend: ",
    "Cost of living: ",
    "What surprised me: ",
    "I live there: ",
  ],
};
---

{enabled && (
  <section
    class:list={["reactions", { preview }]}
    id={preview ? undefined : "reactions"}
    data-reactions={mode}
    data-city={city?.slug}
    data-city-name={name || undefined}
    aria-labelledby={titleId}
    hidden
  >
    <header class="head">
      <h2 id={titleId}>
        {everywhere ? (
          copy.latest
        ) : (
          <>
            {copy.saying} <span data-of>{copy.of}</span>
          </>
        )}
      </h2>
      <p class="count" data-count role={everywhere ? "status" : undefined} />
    </header>

    <ol class="list" data-list />
    {everywhere ? (
      <p class="empty" data-empty hidden>
        {copy.emptyEverywhere}
      </p>
    ) : (
      <p class="empty" data-empty hidden>
        {copy.emptyBefore} <span data-name>{name}</span>
        {copy.emptyAfter}
      </p>
    )}
    <button type="button" class="more" data-more hidden>
      {everywhere ? copy.moreEverywhere : copy.more}
    </button>

    {!everywhere && (
      <div class="actions">
        <button type="button" class="react" data-open aria-expanded="false">
          {copy.react}
        </button>
        {preview && (
          <a class="all" data-all>
            {copy.all}
          </a>
        )}
        {!preview && city && (
          <a class="all" href={`${pathFor("reviews", locale)}?ville=${city.slug}`}>
            {copy.openInReviews}
          </a>
        )}
      </div>
    )}

    <form class="form" data-form novalidate hidden>
      <p class="starters" role="group" aria-label={copy.starters}>
        {STARTERS[locale].map((start) => (
          <button type="button" data-starter={start}>
            {start.replace(/\s*:\s*$/, "")}
          </button>
        ))}
      </p>
      <label class="field">
        {copy.yourReaction}
        <textarea name="text" rows="4" maxlength="1000" required />
      </label>
      <p class="hint">{copy.textHint}</p>
      <label class="field">
        <span>
          {copy.shownName} <span class="dim">{copy.optional}</span>
        </span>
        <input type="text" name="name" maxlength="40" autocomplete="nickname" />
      </label>
      <p class="hint">{copy.nameHint}</p>
      {/* Public by default, one box to keep them back (operator, 2026-11-18). */}
      <label class="check" data-top-field hidden>
        <input type="checkbox" name="private" />
        <span>
          {copy.private}
          <span class="dim">{copy.privateHint}</span>
        </span>
      </label>
      <p class="hint">{copy.review}</p>
      <label class="trap" aria-hidden="true">
        {copy.website}
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
      <p class="error" data-error role="alert" hidden />
      <button type="submit" class="send">
        {copy.send}
      </button>
      <p class="hint">
        <a href={pathFor("privacy", locale)}>{copy.privacy}</a>
      </p>
    </form>

    <p class="pending" data-pending role="status" hidden />

    <template data-item>
      <li class="reaction">
        <header class="byline">
          <span class="avatar" aria-hidden="true"></span>
          <span class="who-when">
            <b class="who"></b>
            <time></time>
          </span>
          <a class="where" data-where hidden></a>
        </header>
        <p class="mention" data-mention hidden></p>
        <p class="text"></p>
        <button type="button" class="read-more" data-read-more aria-expanded="false" hidden>
          {copy.readMore}
        </button>
        {/* DeepL on request (operator, 2026-11-18); shown once the service says it can. */}
        <p class="translation" data-translation hidden>
          <span class="translation-note" data-translation-note></span>
          <button type="button" class="read-more" data-translate>
            {copy.translate}
          </button>
        </p>
        {/* One line at a glance, the detail one tap away (operator's pick C, 2026-11-18). */}
        <button type="button" class="summary" data-summary aria-expanded="false" hidden>
          <span class="first" data-first hidden>
            <span class="place">1</span>
            <span></span>
          </span>
          <span class="temperament" data-temperament hidden></span>
          <span class="others" data-others hidden></span>
        </button>
        <div class="journey" hidden>
          <p class="journey-title">{copy.journeyTitle}</p>
          <ol class="top"></ol>
          <div class="profile" hidden>
            <p class="profile-name">
              {copy.temperament} <b></b>
            </p>
            <ul class="traits"></ul>
            <p class="profile-note">{copy.bigFive}</p>
          </div>
        </div>
        <footer class="tools">
          <div class="marks" data-marks></div>
          <button type="button" class="answer" data-reply aria-expanded="false">
            {copy.reply}
          </button>
          <button type="button" data-report>
            {copy.report}
          </button>
          <button type="button" data-delete hidden>
            {copy.remove}
          </button>
        </footer>
        <ol class="replies" data-replies hidden></ol>
        <div class="slot" data-slot></div>
      </li>
    </template>

    <template data-reply-template>
      <form class="reply-form" novalidate>
        <p class="replying" data-replying></p>
        <label class="field">
          {copy.yourReply}
          <textarea name="text" rows="3" maxlength="1000" required></textarea>
        </label>
        <label class="field">
          <span>
            {copy.shownName} <span class="dim">{copy.optional}</span>
          </span>
          <input type="text" name="name" maxlength="40" autocomplete="nickname" />
        </label>
        <p class="hint">{copy.review}</p>
        <label class="trap" aria-hidden="true">
          {copy.website}
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
        <p class="error" data-error role="alert" hidden></p>
        <button type="submit" class="send">
          {copy.sendReply}
        </button>
      </form>
    </template>

    <template data-login-template>
      <form class="login" novalidate>
        <p>{copy.login}</p>
        <label class="field">
          {copy.email}
          <input
            type="email"
            name="email"
            placeholder={copy.emailPlaceholder}
            autocomplete="email"
          />
        </label>
        <button type="submit" class="send">
          {copy.getLink}
        </button>
        <p class="hint" data-done role="status" hidden>
          {copy.loginDone}
        </p>
      </form>
    </template>
  </section>
)}

<script>
  import { mountThread } from "../lib/reactions-dom";

  const thread = document.querySelector<HTMLElement>('[data-reactions="thread"]');
  if (thread) mountThread(thread);
</script>

<style>
  /* Light on purpose: the one block of the page the eye must not skip (operator, 2026-11-18). */
  .reactions {
    --focus: var(--ink);
    /* Native controls (the checkbox) drawn for a light surface on this dark site. */
    color-scheme: light;
    /* Its own size: the map column of the quiz sets a much larger one. */
    font-size: 1rem;
    display: grid;
    gap: 14px;
    background: var(--thread);
    color: var(--ink);
    border-radius: 20px;
    padding: 18px 16px;
  }
  .reactions[hidden] {
    display: none;
  }
  .reactions :focus-visible {
    outline-color: var(--focus);
  }
  .head {
    display: grid;
    gap: 2px;
  }
  .reactions h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.15;
  }
  p {
    margin: 0;
  }
  .count,
  .hint,
  .dim {
    color: var(--night-lift);
    font-size: 0.85rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .list:empty {
    display: none;
  }
  .reactions :global(.reaction) {
    /* The page caps list items at 68ch for reading; a reaction card spans its block. */
    max-width: none;
    display: grid;
    gap: 10px;
    background: var(--paper);
    border-radius: 16px;
    padding: 14px 16px 10px;
    box-shadow: 0 1px 0 var(--thread-dim);
  }
  .reactions :global(.byline) {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .reactions :global(.avatar) {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--night);
    color: var(--saffron);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
  }
  .reactions :global(.who-when) {
    display: grid;
    line-height: 1.25;
  }
  .reactions :global(.who) {
    color: var(--ink);
    font-size: 0.98rem;
  }
  .reactions :global(time) {
    color: var(--night-lift);
    font-size: 0.8rem;
  }
  .reactions :global(.text) {
    white-space: pre-line;
    overflow-wrap: anywhere;
    font-size: 1rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .preview :global(.text) {
    -webkit-line-clamp: 3;
  }
  .reactions :global(.reaction.open .text) {
    display: block;
    -webkit-line-clamp: unset;
  }
  .reactions :global(.read-more) {
    justify-self: start;
    min-height: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--night);
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .reactions :global(.read-more[hidden]),
  .reactions :global(.translation[hidden]) {
    display: none;
  }
  .reactions :global(.translation) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 0;
  }
  .reactions :global(.translation-note) {
    color: var(--night-lift);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .reactions :global(.translation-note:empty) {
    display: none;
  }
  /* The author's journey: a quieter panel inside the card, so the text stays the main thing. */
  .reactions :global(.journey) {
    display: grid;
    gap: 8px;
    background: var(--thread);
    border-radius: 12px;
    padding: 10px 12px;
  }
  .reactions :global(.journey[hidden]),
  .reactions :global(.profile[hidden]) {
    display: none;
  }
  .reactions :global(.journey-title),
  .reactions :global(.profile-note) {
    color: var(--night-lift);
    font-size: 0.75rem;
  }
  .reactions :global(.journey-title) {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .reactions :global(.top) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .reactions :global(.top li) {
    max-width: none;
  }
  .reactions :global(.top a) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 10px 0 4px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }
  .reactions :global(.top .place) {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--saffron);
    font-size: 0.78rem;
  }
  .reactions :global(.top small) {
    color: var(--night-lift);
    font-weight: 600;
  }
  .reactions :global(.profile) {
    display: grid;
    gap: 6px;
  }
  .reactions :global(.profile-name) {
    font-size: 0.85rem;
    color: var(--night-lift);
  }
  .reactions :global(.profile-name b) {
    margin-left: 4px;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink);
  }
  .reactions :global(.traits) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px 16px;
  }
  .reactions :global(.traits li) {
    max-width: none;
    display: grid;
    grid-template-columns: 7.5em 1fr;
    gap: 8px;
    align-items: center;
    font-size: 0.78rem;
  }
  .reactions :global(.meter) {
    height: 6px;
    border-radius: 3px;
    background: var(--thread-dim);
    overflow: hidden;
  }
  .reactions :global(.meter i) {
    display: block;
    height: 100%;
    background: var(--night);
  }
  .reactions :global(.summary) {
    justify-self: start;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 4px 10px 4px 4px;
    border: 0;
    border-radius: 999px;
    background: var(--thread);
    color: var(--night);
    font-size: 0.8rem;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
  }
  .reactions :global(.summary[hidden]),
  .reactions :global(.summary [hidden]) {
    display: none;
  }
  .reactions :global(.summary::after) {
    content: "▾";
    font-size: 0.65rem;
    color: var(--night-lift);
  }
  .reactions :global(.summary[aria-expanded="true"]::after) {
    content: "▴";
  }
  .reactions :global(.summary .first) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    padding: 0 9px 0 3px;
    border-radius: 999px;
    background: var(--paper);
  }
  .reactions :global(.summary .place) {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--saffron);
    font-size: 0.7rem;
  }
  .reactions :global(.summary .temperament) {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 9px;
    border-radius: 999px;
    background: var(--night);
    color: var(--saffron);
  }
  .reactions :global(.summary .others) {
    color: var(--night-lift);
  }
  .reactions :global(.tools) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 6px 14px;
  }
  /* The marks lead the row, pushed left; the quieter tools stay on the right. */
  .reactions :global(.marks) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-right: auto;
  }
  .reactions :global(.tools .mark) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-width: 40px;
    min-height: 34px;
    padding: 0 10px;
    border: 1px solid var(--thread-dim);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 700;
    justify-content: center;
  }
  .reactions :global(.tools .mark[aria-pressed="true"]) {
    border-color: var(--saffron);
    background: var(--saffron);
  }
  .reactions :global(.tools .mark[hidden]) {
    display: none;
  }
  .reactions :global(.tools .mark:hover) {
    text-decoration: none;
    border-color: var(--night);
  }
  .reactions :global(.tools .answer) {
    color: var(--night);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .reactions :global(.where) {
    margin-left: auto;
    align-self: start;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--night);
    color: var(--saffron);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }
  .reactions :global(.where[hidden]),
  .reactions :global(.mention[hidden]),
  .reactions :global(.replies[hidden]) {
    display: none;
  }
  .reactions :global(.mention) {
    color: var(--night-lift);
    font-size: 0.8rem;
    font-weight: 700;
  }
  /* Two levels only: the replies sit one step in, never deeper. */
  .reactions :global(.replies) {
    list-style: none;
    margin: 0;
    padding: 0 0 0 12px;
    border-left: 2px solid var(--thread-dim);
    display: grid;
    gap: 8px;
  }
  .reactions :global(.reaction.reply) {
    background: var(--thread);
    box-shadow: none;
    padding: 10px 12px 6px;
  }
  .reactions :global(.reply .avatar) {
    width: 32px;
    height: 32px;
    font-size: 0.95rem;
  }
  .reactions :global(.slot:empty) {
    display: none;
  }
  .reactions :global(.reply-form),
  .reactions :global(.login) {
    display: grid;
    gap: 10px;
    padding-top: 6px;
    border-top: 1px solid var(--thread-dim);
  }
  .reactions :global(.replying) {
    color: var(--night-lift);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .reactions :global(.slot .pending) {
    background: var(--night);
    color: var(--thread);
    border-radius: 14px;
    padding: 12px 14px;
    font-size: 0.92rem;
  }
  .reactions :global(.farther) {
    max-width: none;
    padding: 10px 0 2px;
    color: var(--night-lift);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
