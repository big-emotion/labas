---
// With the mail service on (PUBLIC_NEWSLETTER, docs/deploy.md), Là-bas sends the result itself;
// otherwise « Recevoir par e-mail » opens the reader's own mail (approved mockup, 2026-11-16).
// Since 2026-11-17 the e-mail also opens a space: the result is kept there (docs/accounts.md).
// The networks (lib/networks.ts, operator 2026-11-18) are plain links or the phone's share sheet:
// no script of theirs ever loads here.
import { NETWORKS } from "../lib/networks";
import { BRAND, type Bilingual } from "../i18n/locale";
import { localeOfPath, pathFor } from "../i18n/routes";

// The one block of actions on a result (operator, 2026-11-20): the first city hooks the reader,
// so everything they can do next sits right under it (placeHook in lib/why-dom.ts moves the block
// there). Since 2026-11-22 (operator) the one filled button asks for what the site lacks most, a
// useful word on the first city; sharing and the e-mail follow, the full questionnaire is a link
// (7 of 120 readers went there in 30 days) and the rarer ways of sharing fold away.
interface Props {
  /** The quick quiz also offers the full questionnaire, as a link under the actions. */
  further?: boolean;
}
const { further = false } = Astro.props;
const serverMail = Boolean(import.meta.env.PUBLIC_NEWSLETTER);
// WhatsApp first among the folded networks: the phone's share sheet already offers it.
const networks = [
  ...NETWORKS.filter((n) => n.key === "whatsapp"),
  ...NETWORKS.filter((n) => n.key !== "whatsapp"),
];
const locale = localeOfPath(Astro.url.pathname);
const COPY: Bilingual<{
  title: string;
  further: string;
  review: string;
  more: string;
  share: string;
  picture: string;
  print: string;
  mail: string;
  networks: string;
  networksLabel: string;
  shareOn: (network: string) => string;
  mailHint: string;
  email: string;
  placeholder: string;
  website: string;
  sensitiveBefore: string;
  sensitive: string;
  sensitiveAfter: string;
  news: string;
  send: string;
  privacyNote: string;
  privacy: string;
}> = {
  fr: {
    title: "Garder vos résultats",
    further: "Affiner avec le questionnaire complet",
    review: "Laisser une info utile sur cette ville",
    more: "WhatsApp, image, impression, autres réseaux",
    share: "Partager",
    picture: "Enregistrer l'image",
    print: "Imprimer ou PDF",
    mail: "Recevoir par e-mail",
    networks: "Partager sur un réseau",
    networksLabel: "Sur les réseaux",
    shareOn: (network) => `Partager sur ${network}`,
    mailHint: `${BRAND.fr} vous envoie vos trois villes et garde votre résultat dans votre espace : le bouton de l'e-mail l'ouvre, avec le classement complet. Pas de mot de passe.`,
    email: "Votre e-mail",
    placeholder: "vous@exemple.fr",
    website: "Site web",
    sensitiveBefore: "Garder aussi ",
    sensitive: "mon origine, ma religion, ma santé et les lieux écartés",
    sensitiveAfter:
      ", si je les ai données. Sans cette case, elles restent sur ce téléphone et le classement gardé peut changer un peu.",
    news: `Je veux aussi recevoir les nouveautés de ${BRAND.fr} (un e-mail par mois au plus).`,
    send: "Envoyer mes résultats",
    privacyNote:
      "L'e-mail contient vos villes et votre profil, jamais vos réponses. Votre adresse et vos réponses sont effacées sous 7 jours si vous n'ouvrez pas le lien, sinon 3 ans après votre dernière visite, ou dès que vous le demandez dans Mon espace.",
    privacy: "Confidentialité",
  },
  en: {
    title: "Keep your results",
    further: "Refine with the full questionnaire",
    review: "Share something useful about this city",
    more: "WhatsApp, picture, print, other networks",
    share: "Share",
    picture: "Save the picture",
    print: "Print or PDF",
    mail: "Get it by email",
    networks: "Share on a network",
    networksLabel: "On social networks",
    shareOn: (network) => `Share on ${network}`,
    mailHint: `${BRAND.en} sends you your three cities and keeps your result in your space: the button in the email opens it, with the full ranking. No password.`,
    email: "Your email",
    placeholder: "you@example.com",
    website: "Website",
    sensitiveBefore: "Also keep ",
    sensitive: "my origin, my religion, my health and the places I left out",
    sensitiveAfter:
      ", if I gave them. Without this box, they stay on this phone and the kept ranking may change a little.",
    news: `I would also like to receive news from ${BRAND.en} (one email a month at most).`,
    send: "Send my results",
    privacyNote:
      "The email holds your cities and your profile, never your answers. Your address and your answers are erased within 7 days if you do not open the link, otherwise 3 years after your last visit, or as soon as you ask in My space.",
    privacy: "Privacy",
  },
};
const copy = COPY[locale];
---

<div class="keep" data-keep data-hook role="group" aria-label={copy.title}>
  {serverMail && (
    <button type="button" class="review" data-hook-review>
      {copy.review}
    </button>
  )}
  <div class:list={["keep-actions", { lead: !serverMail && !further }]}>
    <button type="button" data-keep-way="partage">
      {copy.share}
    </button>
    {serverMail ? (
      <button type="button" data-keep-way="envoi" aria-expanded="false" aria-controls="keep-mail">
        {copy.mail}
      </button>
    ) : (
      <a href="mailto:" data-keep-way="e-mail">
        {copy.mail}
      </a>
    )}
  </div>
  {further && (
    <a class:list={["further", { lead: !serverMail }]} href={pathFor("deep", locale)}>
      {copy.further}
    </a>
  )}
  <details class="keep-more">
    <summary>{copy.more}</summary>
    <div class="keep-actions">
      <button type="button" data-keep-way="image">
        {copy.picture}
      </button>
      <button type="button" data-keep-way="impression">
        {copy.print}
      </button>
      {networks.map((n) => (
        <a
          href="#"
          data-share-network={n.key}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={copy.shareOn(n.label)}
        >
          {n.label}
        </a>
      ))}
    </div>
  </details>
  {serverMail && (
    <form id="keep-mail" class="keep-mail" data-keep-mail novalidate hidden>
      <p class="keep-hint">{copy.mailHint}</p>
      <label class="field">
        {copy.email}
        <input
          type="email"
          name="email"
          placeholder={copy.placeholder}
          autocomplete="email"
          required
        />
      </label>
      <label class="trap" aria-hidden="true">
        {copy.website}
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
      <label class="consent">
        <input type="checkbox" name="sensitive" />
        <span>
          {copy.sensitiveBefore}
          <b>{copy.sensitive}</b>
          {copy.sensitiveAfter}
        </span>
      </label>
      <label class="consent">
        <input type="checkbox" name="news" />
        <span>{copy.news}</span>
      </label>
      <p class="keep-error" data-keep-error role="alert" hidden />
      <button type="submit" class="send">
        {copy.send}
      </button>
      <p class="keep-hint small">
        {copy.privacyNote} <a href={pathFor("privacy", locale)}>{copy.privacy}</a>
      </p>
    </form>
  )}
  <p class="keep-note" data-keep-note aria-live="polite"></p>
</div>

<style>
  .keep {
    display: grid;
    gap: 10px;
    padding: 16px;
    border-radius: 18px;
    background: var(--night-deep);
    border: 2px solid var(--saffron);
  }
  /* Inside the first city's card (placeHook) the card is the frame. */
  :global(.card) > .keep {
    padding: 0;
    border: 0;
    background: none;
  }
  .review,
  .further.lead {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font: inherit;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }
  .further:not(.lead) {
    justify-self: center;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--saffron);
    font-weight: 700;
    text-underline-offset: 3px;
  }
  .keep-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .keep-actions > * {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 12px;
    border-radius: 999px;
    border: 2px solid var(--thread-dim);
    text-align: center;
    line-height: 1.15;
    background: transparent;
    color: var(--thread);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    cursor: pointer;
  }
  .keep-actions.lead > :first-child {
    background: var(--saffron);
    border-color: var(--saffron);
    color: var(--ink);
  }
  .keep-more summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--thread-dim);
    font-size: 0.92rem;
    text-decoration: underline;
    cursor: pointer;
    list-style: none;
  }
  .keep-more summary::-webkit-details-marker {
    display: none;
  }
  .keep-note:empty {
    display: none;
  }
  .keep-note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--thread-dim);
  }
  .keep :global(.keep-sent-title) {
    margin: 0;
    font-weight: 700;
  }
  .keep :global([data-keep-sent]) {
    display: grid;
    gap: 8px;
  }
  .keep :global([data-keep-sent] .keep-hint) {
    margin: 0;
    font-size: 0.92rem;
    color: var(--thread-dim);
  }
  .keep:has([data-keep-sent]) {
    border: 2px solid var(--saffron);
  }
  :global(.card) > .keep:has([data-keep-sent]) {
    border: 0;
  }
  .keep-actions > [aria-expanded="true"] {
    background: var(--night-pressed);
    border-color: var(--saffron);
  }
  .keep-mail {
    display: grid;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--night-lift);
  }
  .keep-mail[hidden],
  .keep-error[hidden] {
    display: none;
  }
  .keep-hint {
    margin: 0;
    font-size: 0.92rem;
    color: var(--thread-dim);
  }
  .keep-hint.small {
    font-size: 0.82rem;
  }
  .keep-hint a {
    color: var(--saffron);
  }
  .field {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .field input {
    min-height: 48px;
    box-sizing: border-box;
    border-radius: 14px;
    border: 2px solid var(--thread-dim);
    background: var(--night);
    color: var(--thread);
    padding: 0 14px;
    font: inherit;
    font-weight: 400;
  }
  .consent {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .consent input {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--saffron);
  }
  /* Off screen rather than display:none, which some robots skip. */
  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .keep-error {
    margin: 0;
    color: var(--coral);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .send {
    min-height: 48px;
    border: 0;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }
  .send:disabled {
    opacity: 0.4;
  }
  @media print {
    .keep {
      display: none;
    }
  }
</style>
