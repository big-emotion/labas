---
// With the mail service on (PUBLIC_NEWSLETTER, docs/deploy.md), Là-bas sends the result itself;
// otherwise « Recevoir par e-mail » opens the reader's own mail (approved mockup, 2026-11-16).
// Since 2026-11-17 the e-mail also opens a space: the result is kept there (docs/accounts.md).
// The networks (lib/networks.ts, operator 2026-11-18) are plain links or the phone's share sheet:
// no script of theirs ever loads here.
import { NETWORKS } from "../lib/networks";
import { BRAND, type Bilingual } from "../i18n/locale";
import { localeOfPath, pathFor } from "../i18n/routes";

const serverMail = Boolean(import.meta.env.PUBLIC_NEWSLETTER);
const locale = localeOfPath(Astro.url.pathname);
const COPY: Bilingual<{
  title: string;
  share: string;
  picture: string;
  print: string;
  mail: string;
  networks: string;
  networksLabel: string;
  shareOn: (network: string) => string;
  mailHint: string;
  email: string;
  placeholder: string;
  website: string;
  sensitiveBefore: string;
  sensitive: string;
  sensitiveAfter: string;
  news: string;
  send: string;
  privacyNote: string;
  privacy: string;
}> = {
  fr: {
    title: "Garder vos résultats",
    share: "Partager",
    picture: "Enregistrer l'image",
    print: "Imprimer ou PDF",
    mail: "Recevoir par e-mail",
    networks: "Partager sur un réseau",
    networksLabel: "Sur les réseaux",
    shareOn: (network) => `Partager sur ${network}`,
    mailHint: `${BRAND.fr} vous envoie vos trois villes et garde votre résultat dans votre espace : le bouton de l'e-mail l'ouvre, avec le classement complet. Pas de mot de passe.`,
    email: "Votre e-mail",
    placeholder: "vous@exemple.fr",
    website: "Site web",
    sensitiveBefore: "Garder aussi ",
    sensitive: "mon origine, ma religion, ma santé et les lieux écartés",
    sensitiveAfter:
      ", si je les ai données. Sans cette case, elles restent sur ce téléphone et le classement gardé peut changer un peu.",
    news: `Je veux aussi recevoir les nouveautés de ${BRAND.fr} (un e-mail par mois au plus).`,
    send: "Envoyer mes résultats",
    privacyNote:
      "L'e-mail contient vos villes et votre profil, jamais vos réponses. Votre adresse et vos réponses sont effacées sous 7 jours si vous n'ouvrez pas le lien, sinon 3 ans après votre dernière visite, ou dès que vous le demandez dans Mon espace.",
    privacy: "Confidentialité",
  },
  en: {
    title: "Keep your results",
    share: "Share",
    picture: "Save the picture",
    print: "Print or PDF",
    mail: "Get it by email",
    networks: "Share on a network",
    networksLabel: "On social networks",
    shareOn: (network) => `Share on ${network}`,
    mailHint: `${BRAND.en} sends you your three cities and keeps your result in your space: the button in the email opens it, with the full ranking. No password.`,
    email: "Your email",
    placeholder: "you@example.com",
    website: "Website",
    sensitiveBefore: "Also keep ",
    sensitive: "my origin, my religion, my health and the places I left out",
    sensitiveAfter:
      ", if I gave them. Without this box, they stay on this phone and the kept ranking may change a little.",
    news: `I would also like to receive news from ${BRAND.en} (one email a month at most).`,
    send: "Send my results",
    privacyNote:
      "The email holds your cities and your profile, never your answers. Your address and your answers are erased within 7 days if you do not open the link, otherwise 3 years after your last visit, or as soon as you ask in My space.",
    privacy: "Privacy",
  },
};
const copy = COPY[locale];
---

<div class="keep" data-keep>
  <h3>{copy.title}</h3>
  <div class="keep-actions">
    <button type="button" data-keep-way="partage">
      {copy.share}
    </button>
    <button type="button" data-keep-way="image">
      {copy.picture}
    </button>
    <button type="button" data-keep-way="impression">
      {copy.print}
    </button>
    {serverMail ? (
      <button type="button" data-keep-way="envoi" aria-expanded="false" aria-controls="keep-mail">
        {copy.mail}
      </button>
    ) : (
      <a href="mailto:" data-keep-way="e-mail">
        {copy.mail}
      </a>
    )}
  </div>
  <div class="networks" role="group" aria-label={copy.networks}>
    <span class="networks-label">{copy.networksLabel}</span>
    {NETWORKS.map((n) => (
      <a
        href="#"
        data-share-network={n.key}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={copy.shareOn(n.label)}
      >
        {n.label}
      </a>
    ))}
  </div>
  {serverMail && (
    <form id="keep-mail" class="keep-mail" data-keep-mail novalidate hidden>
      <p class="keep-hint">{copy.mailHint}</p>
      <label class="field">
        {copy.email}
        <input
          type="email"
          name="email"
          placeholder={copy.placeholder}
          autocomplete="email"
          required
        />
      </label>
      <label class="trap" aria-hidden="true">
        {copy.website}
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
      <label class="consent">
        <input type="checkbox" name="sensitive" />
        <span>
          {copy.sensitiveBefore}
          <b>{copy.sensitive}</b>
          {copy.sensitiveAfter}
        </span>
      </label>
      <label class="consent">
        <input type="checkbox" name="news" />
        <span>{copy.news}</span>
      </label>
      <p class="keep-error" data-keep-error role="alert" hidden />
      <button type="submit" class="send">
        {copy.send}
      </button>
      <p class="keep-hint small">
        {copy.privacyNote} <a href={pathFor("privacy", locale)}>{copy.privacy}</a>
      </p>
    </form>
  )}
  <p class="keep-note" data-keep-note aria-live="polite"></p>
</div>

<style>
  .keep {
    display: grid;
    gap: 10px;
    margin-top: 18px;
    padding: 16px;
    border-radius: 18px;
    background: var(--night-deep);
    border: 1px solid var(--night-lift);
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .keep-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .keep-actions > * {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 2px solid var(--thread-dim);
    background: transparent;
    color: var(--thread);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    cursor: pointer;
  }
  .keep-actions > :first-child {
    background: var(--saffron);
    border-color: var(--saffron);
    color: var(--ink);
  }
  .networks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .networks-label {
    width: 100%;
    font-size: 0.88rem;
    color: var(--thread-dim);
  }
  .networks a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--night-lift);
    background: var(--night);
    color: var(--thread);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .networks a:hover,
  .networks a:focus-visible {
    border-color: var(--saffron);
  }
  .keep-note:empty {
    display: none;
  }
  .keep-note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--thread-dim);
  }
  .keep :global(.keep-sent-title) {
    margin: 0;
    font-weight: 700;
  }
  .keep :global([data-keep-sent]) {
    display: grid;
    gap: 8px;
  }
  .keep :global([data-keep-sent] .keep-hint) {
    margin: 0;
    font-size: 0.92rem;
    color: var(--thread-dim);
  }
  .keep:has([data-keep-sent]) {
    border: 2px solid var(--saffron);
  }
  .keep-actions > [aria-expanded="true"] {
    background: var(--night-pressed);
    border-color: var(--saffron);
  }
  .keep-mail {
    display: grid;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--night-lift);
  }
  .keep-mail[hidden],
  .keep-error[hidden] {
    display: none;
  }
  .keep-hint {
    margin: 0;
    font-size: 0.92rem;
    color: var(--thread-dim);
  }
  .keep-hint.small {
    font-size: 0.82rem;
  }
  .keep-hint a {
    color: var(--saffron);
  }
  .field {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .field input {
    min-height: 48px;
    box-sizing: border-box;
    border-radius: 14px;
    border: 2px solid var(--thread-dim);
    background: var(--night);
    color: var(--thread);
    padding: 0 14px;
    font: inherit;
    font-weight: 400;
  }
  .consent {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .consent input {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--saffron);
  }
  /* Off screen rather than display:none, which some robots skip. */
  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .keep-error {
    margin: 0;
    color: var(--coral);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .send {
    min-height: 48px;
    border: 0;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }
  .send:disabled {
    opacity: 0.4;
  }
  @media print {
    .keep {
      display: none;
    }
  }
</style>
