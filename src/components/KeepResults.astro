---
// With the mail service on (PUBLIC_NEWSLETTER, docs/deploy.md), Là-bas sends the result itself;
// otherwise « Recevoir par e-mail » opens the reader's own mail (approved mockup, 2026-11-16).
// Since 2026-11-17 the e-mail also opens a space: the result is kept there (docs/accounts.md).
const serverMail = Boolean(import.meta.env.PUBLIC_NEWSLETTER);
---

<div class="keep" data-keep>
  <h3>Garder vos résultats</h3>
  <div class="keep-actions">
    <button type="button" data-keep-way="partage">
      Partager
    </button>
    <button type="button" data-keep-way="image">
      Enregistrer l'image
    </button>
    <button type="button" data-keep-way="impression">
      Imprimer ou PDF
    </button>
    {serverMail ? (
      <button type="button" data-keep-way="envoi" aria-expanded="false" aria-controls="keep-mail">
        Recevoir par e-mail
      </button>
    ) : (
      <a href="mailto:" data-keep-way="e-mail">
        Recevoir par e-mail
      </a>
    )}
  </div>
  {serverMail && (
    <form id="keep-mail" class="keep-mail" data-keep-mail novalidate hidden>
      <p class="keep-hint">
        Là-bas vous envoie vos trois villes et garde votre résultat dans votre espace : le bouton de
        l'e-mail l'ouvre, avec le classement complet. Pas de mot de passe.
      </p>
      <label class="field">
        Votre e-mail
        <input
          type="email"
          name="email"
          placeholder="vous@exemple.fr"
          autocomplete="email"
          required
        />
      </label>
      <label class="trap" aria-hidden="true">
        Site web
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
      <label class="consent">
        <input type="checkbox" name="sensitive" />
        <span>
          Garder aussi <b>mon origine, ma religion et ma santé</b>, si je les ai données. Sans cette
          case, elles restent sur ce téléphone et le classement gardé peut changer un peu.
        </span>
      </label>
      <label class="consent">
        <input type="checkbox" name="news" />
        <span>Je veux aussi recevoir les nouveautés de Là-bas (un e-mail par mois au plus).</span>
      </label>
      <p class="keep-error" data-keep-error role="alert" hidden />
      <button type="submit" class="send">
        Envoyer mes résultats
      </button>
      <p class="keep-hint small">
        L'e-mail contient vos villes et votre profil, jamais vos réponses. Votre adresse et vos
        réponses sont effacées sous 7 jours si vous n'ouvrez pas le lien, sinon 3 ans après votre
        dernière visite, ou dès que vous le demandez dans Mon espace.{" "}
        <a href="/confidentialite">Confidentialité</a>
      </p>
    </form>
  )}
  <p class="keep-note" data-keep-note aria-live="polite"></p>
</div>

<style>
  .keep {
    display: grid;
    gap: 10px;
    margin-top: 18px;
    padding: 16px;
    border-radius: 18px;
    background: var(--night-deep);
    border: 1px solid var(--night-lift);
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .keep-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .keep-actions > * {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 2px solid var(--thread-dim);
    background: transparent;
    color: var(--thread);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    cursor: pointer;
  }
  .keep-actions > :first-child {
    background: var(--saffron);
    border-color: var(--saffron);
    color: var(--ink);
  }
  .keep-note:empty {
    display: none;
  }
  .keep-note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--thread-dim);
  }
  .keep :global(.keep-sent-title) {
    margin: 0;
    font-weight: 700;
  }
  .keep :global([data-keep-sent]) {
    display: grid;
    gap: 8px;
  }
  .keep :global([data-keep-sent] .keep-hint) {
    margin: 0;
    font-size: 0.92rem;
    color: var(--thread-dim);
  }
  .keep:has([data-keep-sent]) {
    border: 2px solid var(--saffron);
  }
  .keep-actions > [aria-expanded="true"] {
    background: var(--night-pressed);
    border-color: var(--saffron);
  }
  .keep-mail {
    display: grid;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--night-lift);
  }
  .keep-mail[hidden],
  .keep-error[hidden] {
    display: none;
  }
  .keep-hint {
    margin: 0;
    font-size: 0.92rem;
    color: var(--thread-dim);
  }
  .keep-hint.small {
    font-size: 0.82rem;
  }
  .keep-hint a {
    color: var(--saffron);
  }
  .field {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .field input {
    min-height: 48px;
    box-sizing: border-box;
    border-radius: 14px;
    border: 2px solid var(--thread-dim);
    background: var(--night);
    color: var(--thread);
    padding: 0 14px;
    font: inherit;
    font-weight: 400;
  }
  .consent {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .consent input {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--saffron);
  }
  /* Off screen rather than display:none, which some robots skip. */
  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .keep-error {
    margin: 0;
    color: var(--coral);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .send {
    min-height: 48px;
    border: 0;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }
  .send:disabled {
    opacity: 0.4;
  }
  @media print {
    .keep {
      display: none;
    }
  }
</style>
