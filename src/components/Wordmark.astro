---
// The grave accent of « là » is drawn as Africa, tilted, at the end of a dotted flight path:
// the name already says where (logo direction chosen 2026-11-15). The outline is a simplified
// coastline traced from real coordinates, Madagascar left out at this size.
---

<span class="wordmark" role="img" aria-label="Là-bas">
  <span aria-hidden="true">l</span>
  <span class="accented" aria-hidden="true">
    a
    <svg viewBox="0 0 100 100">
      <path class="trail" d="M-70 70 C -45 45, -20 40, 4 46"></path>
      <path
        class="africa"
        transform="rotate(-18 50 50)"
        d="M19.7 4.0 L26.2 4.7 L31.6 2.7 L41.1 2.0 L42.2 4.8 L41.0 6.7 L47.5 8.5 L53.5 11.2 L54.3 8.9 L60.9 9.6 L67.4 10.1 L70.6 10.0 L71.0 11.9 L72.6 15.4 L75.0 19.8 L77.1 25.6 L79.9 30.9 L84.4 34.6 L85.2 36.2 L86.8 37.8 L95.7 36.0 L95.5 37.8 L93.5 43.7 L88.8 49.0 L84.3 52.3 L80.4 57.0 L79.9 60.7 L81.5 65.6 L81.8 71.6 L76.7 75.5 L73.9 78.0 L74.8 83.5 L71.0 86.1 L71.4 90.0 L68.8 91.5 L64.8 95.5 L61.7 96.8 L54.2 98.0 L52.1 97.2 L51.8 93.6 L49.5 89.7 L47.5 87.1 L46.9 82.2 L44.9 78.3 L43.3 74.6 L43.9 69.6 L45.1 63.4 L43.9 59.7 L43.3 58.1 L39.5 53.0 L40.2 51.1 L40.5 46.3 L38.9 45.7 L35.6 45.9 L32.1 43.1 L29.2 43.5 L24.9 45.3 L22.2 44.6 L17.6 45.8 L13.2 43.3 L10.0 40.3 L7.6 37.2 L5.3 34.2 L4.3 32.1 L5.6 30.4 L6.3 26.4 L4.9 23.7 L7.6 19.7 L10.3 14.8 L14.8 11.2 L17.4 6.9 L18.5 6.4 Z"
      ></path>
    </svg>
  </span>
  <span class="dash" aria-hidden="true">
    -
  </span>
  <span aria-hidden="true">bas</span>
</span>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
  }
  .accented {
    position: relative;
    display: inline-block;
  }
  svg {
    position: absolute;
    left: 0.1em;
    bottom: 0.6em;
    width: 0.56em;
    height: 0.56em;
    overflow: visible;
  }
  .trail {
    fill: none;
    stroke: currentColor;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 1 13;
    opacity: 0.7;
  }
  .africa {
    fill: var(--saffron);
  }
  .dash {
    color: var(--saffron);
  }
</style>
