---
import { canonicalUrl, shareImageFor } from "../lib/share";
import { BRAND, LANGUAGE_TAG } from "../i18n/locale";
import { counterpartBuilt, localeOfPath } from "../i18n/routes";

interface Props {
  /** The full document title, as shown in the tab and in shared links. */
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const url = canonicalUrl(Astro.url.pathname);
const image = shareImageFor(Astro.url.pathname);
const locale = localeOfPath(Astro.url.pathname);
const other = locale === "fr" ? "en" : "fr";
const otherUrl = canonicalUrl(counterpartBuilt(Astro.url.pathname));
const frUrl = locale === "fr" ? url : otherUrl;
const enUrl = locale === "en" ? url : otherUrl;
---

<link rel="canonical" href={url} />
<link rel="alternate" hreflang="fr" href={frUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={frUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={BRAND[locale]} />
<meta property="og:locale" content={LANGUAGE_TAG[locale].og} />
<meta property="og:locale:alternate" content={LANGUAGE_TAG[other].og} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
