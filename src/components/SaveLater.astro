---
/**
 * « Reprendre plus tard » (approved mockup, 2026-11-16): beside the progress of either quiz.
 * Signed in, the journey goes straight to Mon espace; otherwise an e-mail, the explicit consent
 * box naming the sensitive answers, and a link by e-mail. Shown only with the mail service on.
 */
import { BRAND, type Bilingual } from "../i18n/locale";
import { localeOfPath, pathFor } from "../i18n/routes";

interface Props {
  kind: "quick" | "deep";
}
const { kind } = Astro.props;
const enabled = Boolean(import.meta.env.PUBLIC_NEWSLETTER);
const locale = localeOfPath(Astro.url.pathname);
const COPY = {
  fr: {
    toggle: "Reprendre plus tard",
    lead: "Recevez un lien pour retrouver votre parcours là où vous en êtes, sur ce téléphone ou un autre. Pas de mot de passe.",
    email: "Votre e-mail",
    emailPlaceholder: "vous@exemple.fr",
    website: "Site web",
    consent: `J'accepte que ${BRAND.fr} garde mes réponses pour retrouver mon parcours.`,
    required: "Obligatoire pour enregistrer.",
    keepAlso: "Garder aussi",
    sensitive: "mon origine, ma religion, ma santé et les lieux écartés",
    ifGiven: "si je les ai données.",
    staysHere: "Sans cette case, elles restent dans ce navigateur.",
    news: `Je veux aussi recevoir les nouveautés de ${BRAND.fr} (un e-mail par mois au plus).`,
    send: "M'envoyer le lien",
    kept: "Vos réponses sont effacées 3 ans après votre dernière visite, ou dès que vous le demandez dans Mon espace. Elles ne sont jamais données à un partenaire.",
    privacy: "Confidentialité",
    memberFailed: "L'enregistrement n'a pas marché. Réessayez dans un instant.",
    memberSave: "Enregistrer dans Mon espace",
  },
  en: {
    toggle: "Continue later",
    lead: "Get a link to find your journey where you left it, on this phone or another. No password.",
    email: "Your email",
    emailPlaceholder: "you@example.com",
    website: "Website",
    consent: `I agree that ${BRAND.en} keeps my answers so I can find my journey again.`,
    required: "Required to save.",
    keepAlso: "Also keep",
    sensitive: "my origin, my faith, my health and the places I left out",
    ifGiven: "if I gave them.",
    staysHere: "Without this box, they stay in this browser.",
    news: `I also want to receive ${BRAND.en} news (one email a month at most).`,
    send: "Send me the link",
    kept: "Your answers are erased 3 years after your last visit, or as soon as you ask in My space. They are never given to a partner.",
    privacy: "Privacy",
    memberFailed: "Saving didn't work. Try again in a moment.",
    memberSave: "Save in My space",
  },
} satisfies Bilingual<Record<string, string>>;
const copy = COPY[locale];
---

{enabled && (
  <div class="save-later" data-save-later data-kind={kind}>
    <button
      type="button"
      class="save-toggle"
      data-save-toggle
      aria-expanded="false"
      aria-controls={`save-${kind}`}
    >
      {copy.toggle}
    </button>
    <section id={`save-${kind}`} class="panel" data-save-panel aria-label={copy.toggle} hidden>
      <div data-save-intro>
        <h2>{copy.toggle}</h2>
        <p class="lead">{copy.lead}</p>
      </div>
      <form novalidate>
        <label class="field">
          {copy.email}
          <input
            type="email"
            name="email"
            placeholder={copy.emailPlaceholder}
            autocomplete="email"
            required
          />
        </label>
        <label class="trap" aria-hidden="true">
          {copy.website}
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
        <label class="consent">
          <input type="checkbox" name="consent" />
          <span>
            {copy.consent} <span class="dim">{copy.required}</span>
          </span>
        </label>
        <label class="consent">
          <input type="checkbox" name="sensitive" />
          <span>
            {copy.keepAlso} <b>{copy.sensitive}</b> {copy.ifGiven}{" "}
            <span class="dim">{copy.staysHere}</span>
          </span>
        </label>
        <label class="consent">
          <input type="checkbox" name="news" />
          <span>{copy.news}</span>
        </label>
        <p class="error" data-save-error role="alert" hidden />
        <button type="submit" class="send">
          {copy.send}
        </button>
        <p class="small">
          {copy.kept} <a href={pathFor("privacy", locale)}>{copy.privacy}</a>
        </p>
      </form>
      <form data-save-member novalidate hidden>
        <label class="consent">
          <input type="checkbox" name="sensitive" />
          <span>
            {copy.keepAlso} <b>{copy.sensitive}</b> {copy.ifGiven}{" "}
            <span class="dim">{copy.staysHere}</span>
          </span>
        </label>
        <p class="error" data-save-member-error role="alert" hidden>
          {copy.memberFailed}
        </p>
        <button type="submit" class="send">
          {copy.memberSave}
        </button>
      </form>
      <p class="done-text" data-save-done role="status" hidden>
        <b />
        <span />
      </p>
    </section>
  </div>
)}

<script>
  import { wireSaveLater } from "../lib/account-dom";
  import { loadAnswers } from "../lib/keep";
  import { browserStore } from "../lib/keep-dom";

  // Both quizzes keep every answer in the browser as it is given: that is what gets saved.
  for (const block of document.querySelectorAll<HTMLElement>("[data-save-later]")) {
    wireSaveLater(block.dataset.kind as "quick" | "deep", () => loadAnswers(browserStore()));
  }
</script>

<style>
  .save-later {
    display: grid;
    gap: 12px;
  }
  .save-toggle {
    justify-self: end;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--saffron);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    padding: 0 4px;
    cursor: pointer;
  }
  .panel {
    display: grid;
    gap: 12px;
    background: var(--night-deep);
    border: 2px solid var(--saffron);
    border-radius: 18px;
    padding: 18px;
  }
  .panel.done {
    border-width: 2px;
  }
  [data-save-intro],
  form {
    display: grid;
    gap: 12px;
    margin: 0;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.15;
  }
  p {
    margin: 0;
  }
  .lead {
    color: var(--thread-dim);
    font-size: 0.92rem;
  }
  .small,
  .dim {
    color: var(--thread-dim);
    font-size: 0.82rem;
  }
  .small a {
    color: var(--saffron);
  }
  .field {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  input[type="email"] {
    min-height: 48px;
    box-sizing: border-box;
    border-radius: 14px;
    border: 2px solid var(--thread-dim);
    background: var(--night);
    color: var(--thread);
    padding: 0 14px;
    font: inherit;
    font-weight: 400;
  }
  .consent {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .consent input {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--saffron);
  }
  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .error {
    color: var(--coral);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .send {
    min-height: 48px;
    border: 0;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }
  .send:disabled {
    opacity: 0.4;
  }
  .done-text {
    display: grid;
    gap: 6px;
  }
  .done-text span {
    color: var(--thread-dim);
    font-size: 0.92rem;
  }
  .save-later [hidden] {
    display: none;
  }
</style>
