---
// The result cards and rows, shared by the quick quiz and the full questionnaire. Rendered by
// lib/cards-dom.ts; the page wraps cards in .results and rows in .rows.
const reactions = Boolean(import.meta.env.PUBLIC_NEWSLETTER);
---

<template id="card-template">
  <article class="card">
    <header class="card-head">
      <span class="rank"></span>
      <div>
        <h3 class="card-name"></h3>
        <p class="card-country"></p>
        <a class="card-reactions" hidden></a>
      </div>
      <span class="fit">
        <b></b>
        <small>proche de vous</small>
      </span>
    </header>
    <p class="split"></p>
    <ul class="why-temper"></ul>
    <figure class="photo" hidden>
      <img alt="" width="1280" height="853" loading="lazy" />
      <figcaption></figcaption>
    </figure>
    <p class="card-pitch"></p>
    <div class="rated" data-block="why">
      <h4>Pourquoi vous</h4>
      <ul></ul>
    </div>
    <div class="rated against" data-block="against">
      <h4>Ce qui joue contre elle</h4>
      <ul></ul>
    </div>
    <div class="rated" data-block="living">
      <h4>Si vous y viviez</h4>
      <ul></ul>
    </div>
    <ul class="facts"></ul>
    <p class="same"></p>
    <a class="go" hidden>
      Y aller
    </a>
    <details class="detail">
      <summary>
        <span class="when-closed">Voir le détail</span>
        <span class="when-open">Masquer le détail</span>
      </summary>
    </details>
  </article>
</template>

<template id="row-template">
  <li class="row">
    <details class="detail">
      <summary class="row-head">
        <span class="rank"></span>
        <span class="row-name">
          <b></b> <span class="row-country"></span>
        </span>
        <span class="fit"></span>
        <span class="row-tagline"></span>
        <span class="bar">
          <span></span>
        </span>
      </summary>
    </details>
  </li>
</template>

<template id="detail-template">
  <div class="detail-body">
    <div class="field" data-field="portrait">
      <h4 class="portrait-title"></h4>
      <ul class="portrait"></ul>
    </div>
    <div class="field" data-field="reputation">
      <span class="eyebrow">On dit</span>
      <p class="quote"></p>
    </div>
    <div class="field" data-field="surprise">
      <h4>Ce qui pourrait vous surprendre</h4>
      <p></p>
    </div>
    <div class="field" data-field="neighbourhoods">
      <h4>Les quartiers</h4>
      <ul class="places"></ul>
      <p class="small">Loyers affichés, souvent négociables.</p>
    </div>
    <div class="field" data-field="reasons">
      <h4>Ses points forts pour vous</h4>
      <ul class="reasons"></ul>
    </div>
    <div class="field watch" data-field="watch">
      <h4>À savoir</h4>
      <p></p>
    </div>
    <div class="field watch" data-field="advisory">
      <h4>L'avis des autorités</h4>
      <p></p>
    </div>
    {/* Every city of the result leads to its reactions (operator, 2026-11-18). */}
    <a class="field full" data-field="reactions" hidden={!reactions}></a>
    <a class="field full" data-field="full">
      Voir la fiche complète, critère par critère, avec ses sources
    </a>
  </div>
</template>

<style is:global>
  .cards,
  .rows {
    display: grid;
    gap: 12px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }
  .results .card {
    background: var(--night-deep);
    border: 1px solid var(--night-lift);
    border-radius: 18px;
    padding: 18px;
    display: grid;
    gap: 10px;
  }
  /* The city in first place: framed in saffron, bigger, with its "pourquoi vous" open. */
  .results .card.first {
    border: 2px solid var(--saffron);
    gap: 14px;
  }
  .results .card-head,
  .rows .row-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: 12px;
    align-items: center;
  }
  .results .rank {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.8rem;
    line-height: 1;
    color: var(--saffron);
  }
  .results .first .rank,
  .results .first h3 {
    font-size: clamp(2.2rem, 10vw, 2.8rem);
  }
  .results h3 {
    font-family: var(--font-display);
    font-size: 1.45rem;
    margin: 0;
    line-height: 1.05;
  }
  .results .card-country,
  .results .card-tagline {
    margin: 0;
    color: var(--thread-dim);
    font-size: 0.85rem;
  }
  /* Cards 2 and 3 only (reactions-dom showCounts): the first one carries the preview itself. */
  .results .card-reactions {
    display: inline-block;
    margin-top: 4px;
    color: var(--saffron);
    font-size: 0.85rem;
    font-weight: 700;
    text-underline-offset: 3px;
  }
  .results .card-reactions[hidden] {
    display: none;
  }
  .results .card-tagline,
  .rows .row-tagline {
    font-family: var(--font-mono);
    color: var(--saffron);
    font-size: 0.85rem;
  }
  .results .fit,
  .rows .fit {
    font-family: var(--font-mono);
    color: var(--saffron);
  }
  .results .card-pitch {
    margin: 0;
    font-size: 0.95rem;
  }
  .results .bar,
  .rows .bar {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: var(--night-lift);
    overflow: hidden;
  }
  .results .bar > span,
  .rows .bar > span {
    display: block;
    height: 100%;
    background: var(--saffron);
    border-radius: 999px;
  }
  .results .portrait-box[hidden] {
    display: none;
  }
  .results .portrait-box {
    background: var(--night-lift);
    border-radius: 14px;
    padding: 14px;
    display: grid;
    gap: 10px;
  }
  .results h4,
  .rows h4 {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
  }
  .results .portrait-title,
  .rows .portrait-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .results .portrait,
  .rows .portrait {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .results .portrait li,
  .rows .portrait li {
    display: grid;
    gap: 2px;
    padding-left: 12px;
    border-left: 3px solid var(--saffron);
  }
  .results .said,
  .rows .said {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--thread-dim);
  }
  .results details.detail > summary {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 2px solid var(--thread);
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.92rem;
    cursor: pointer;
    list-style: none;
  }
  details.detail > summary::-webkit-details-marker {
    display: none;
  }
  details.detail:not([open]) .when-open,
  details.detail[open] .when-closed {
    display: none;
  }
  .results details.detail {
    display: grid;
    gap: 14px;
  }
  .detail-body {
    display: grid;
    gap: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--night-pressed);
    font-size: 0.95rem;
  }
  .detail-body .field {
    display: grid;
    gap: 6px;
  }
  .detail-body p {
    margin: 0;
  }
  .detail-body .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--saffron);
  }
  .detail-body .quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.35;
  }
  .detail-body .places {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .detail-body .places li {
    background: var(--night);
    border-radius: 10px;
    padding: 8px 12px;
  }
  .detail-body .small,
  .detail-body .sources {
    font-size: 0.8rem;
    color: var(--thread-dim);
  }
  .detail-body .reasons {
    margin: 0;
    padding-left: 1.1em;
  }
  .detail-body .watch {
    border: 2px solid var(--coral);
    border-radius: 14px;
    padding: 12px 14px;
  }
  .detail-body .watch h4 {
    color: var(--coral);
  }
  .detail-body .sources summary {
    cursor: pointer;
  }
  .detail-body .sources ul {
    margin: 6px 0 0;
    padding-left: 1.1em;
  }
  .detail-body a {
    color: var(--saffron);
  }
  .rows .row {
    border-bottom: 1px solid var(--night-lift);
    padding: 12px 0;
  }
  .rows .row-head {
    grid-template-columns: 32px minmax(0, 1fr) auto;
    row-gap: 6px;
  }
  .rows summary.row-head {
    cursor: pointer;
    list-style: none;
    min-height: 44px;
  }
  .rows .rank {
    font-family: var(--font-mono);
    color: var(--saffron);
    font-size: 0.9rem;
  }
  .rows .row-country {
    color: var(--thread-dim);
  }
  .rows .row-tagline,
  .rows .bar,
  .rows .row-note {
    grid-column: 2 / -1;
  }
  .rows .row-tagline {
    color: var(--thread-dim);
    font-family: var(--font-body);
  }
  .rows .detail-body {
    margin-top: 12px;
    background: var(--night-deep);
    border: 0;
    border-radius: 14px;
    padding: 14px;
  }
  .results .photo {
    margin: 0;
  }
  .results .photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 14px;
    display: block;
  }
  .results .photo figcaption {
    font-size: 0.75rem;
    color: var(--thread-dim);
    margin-top: 4px;
  }
  /* Result cards: same fields for each city, reasons rated 1 to 5. */
  .results .card .fit {
    text-align: right;
  }
  .results .card .fit b {
    display: block;
    font-size: 1.8rem;
    line-height: 1;
  }
  .results .card .fit small {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--thread-dim);
  }
  /* Why the temperament part: the neighbourhoods at the reader's level. */
  .results .why-temper {
    margin: 0;
    padding-left: 1.1em;
    font-size: 0.88rem;
    color: var(--thread-dim);
  }
  .results .why-temper .weak {
    color: var(--coral);
  }
  .results .why-temper:empty {
    display: none;
  }
  .results .split,
  .results .same {
    margin: 0;
    font-size: 0.9rem;
    color: var(--thread-dim);
  }
  .results .go:not([hidden]) {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .results .split b {
    color: var(--thread);
  }
  .results .rated h4 {
    margin: 0 0 6px;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--thread-dim);
  }
  .results .rated ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .results .rated li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .results .rated[hidden] {
    display: none;
  }
  .results .pips {
    display: inline-flex;
    gap: 3px;
    flex: none;
  }
  .results .pips i {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: var(--night-lift);
  }
  .results .pips i.on {
    background: var(--saffron);
  }
  .results .against .pips i.on {
    background: var(--coral);
  }
  .results .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .results .facts li {
    background: var(--night-lift);
    border-radius: 999px;
    padding: 4px 11px;
    font-size: 0.82rem;
  }
</style>
