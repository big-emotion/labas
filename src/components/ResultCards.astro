---
// The result cards and rows, shared by the quick quiz and the full questionnaire. Rendered by
// lib/cards-dom.ts; the page wraps cards in .results and rows in .rows.
import type { Bilingual } from "../i18n/locale";
import { localeOfPath } from "../i18n/routes";

const reactions = Boolean(import.meta.env.PUBLIC_NEWSLETTER);
const COPY: Bilingual<Record<string, string>> = {
  fr: {
    close: "proche de vous",
    why: "Pourquoi vous",
    against: "Ce qui joue contre elle",
    living: "Si vous y viviez",
    go: "Comment y aller",
    discover: "À découvrir",
    notForMe: "Pas pour moi",
    open: "Voir le détail",
    openShort: "Détail",
    inviteWhy:
      "Là-bas sert aussi à ceux qui préparent leur départ : ce que vous savez de la ville les aide.",
    hide: "Masquer le détail",
    said: "On dit",
    surprise: "Ce qui pourrait vous surprendre",
    neighbourhoods: "Les quartiers",
    rents: "Loyers affichés, souvent négociables.",
    strengths: "Ses points forts pour vous",
    watch: "À savoir",
    advisory: "L'avis des autorités",
    full: "Voir la fiche complète, critère par critère, avec ses sources",
  },
  en: {
    close: "close to you",
    why: "Why you",
    against: "What counts against it",
    living: "If you lived there",
    go: "How to get there",
    discover: "To discover",
    notForMe: "Not for me",
    open: "See the details",
    openShort: "Details",
    inviteWhy:
      "Over There also helps people preparing to move: what you know about the city helps them.",
    hide: "Hide the details",
    said: "People say",
    surprise: "What might surprise you",
    neighbourhoods: "The neighbourhoods",
    rents: "Advertised rents, often negotiable.",
    strengths: "Its strengths for you",
    watch: "Good to know",
    advisory: "What the authorities advise",
    full: "See the full page, criterion by criterion, with its sources",
  },
};
const copy = COPY[localeOfPath(Astro.url.pathname)];
---

<template id="card-template">
  <article class="card">
    <header class="card-head">
      <span class="rank"></span>
      <div>
        <h3 class="card-name"></h3>
        <p class="card-country"></p>
        {/* Outside what the reader's family knows (Match.toDiscover): a label, not a rank. */}
        <span class="discover" hidden>
          {copy.discover}
        </span>
        <a class="card-reactions" hidden></a>
      </div>
      <span class="fit">
        <b></b>
        <small>{copy.close}</small>
        <span class="bar">
          <span></span>
        </span>
      </span>
    </header>
    {/* Right under the name (operator, 2026-11-22): the place is what the reader came for. */}
    <figure class="photo" hidden>
      <img alt="" width="1280" height="853" loading="lazy" />
      <figcaption></figcaption>
    </figure>
    <div class="split"></div>
    <ul class="why-temper"></ul>
    {/* The one-tap reaction, built by lib/taps-dom.ts, right under the city's name: reacting
        must not wait for the end of a long card. The first card asks its question aloud. */}
    <p class="taps-ask" hidden></p>
    <div data-taps></div>
    {/* Shown and wired by the quick quiz only (« Pas pour moi », 2026-11-18), right under the
        reaction it answers so it is seen (operator, 2026-11-22). */}
    <button type="button" class="not-for-me" hidden>
      {copy.notForMe}
    </button>
    {/* After a tap on the first city (operator, 2026-11-22): a reader who reacts in a second is
        asked for a useful word; the action block placed right after holds the button. */}
    {reactions && (
      <div class="invite" data-invite hidden>
        <p class="invite-line">
          <span class="invite-ask"></span>
        </p>
        <p class="invite-why">{copy.inviteWhy}</p>
      </div>
    )}
    <p class="card-pitch"></p>
    <div class="rated" data-block="why">
      <h4>{copy.why}</h4>
      <ul></ul>
    </div>
    <div class="rated against" data-block="against">
      <h4>{copy.against}</h4>
      <ul></ul>
    </div>
    <div class="rated" data-block="living">
      <h4>{copy.living}</h4>
      <ul></ul>
    </div>
    <ul class="facts"></ul>
    <p class="same"></p>
    <a class="go" hidden>
      {copy.go}
    </a>
    <details class="detail">
      <summary>
        <span class="when-closed">
          <span class="open-long">{copy.open}</span>
          <span class="open-short">{copy.openShort}</span>
        </span>
        <span class="when-open">{copy.hide}</span>
      </summary>
    </details>
  </article>
</template>

<template id="row-template">
  <li class="row">
    <details class="detail">
      <summary class="row-head">
        <span class="rank"></span>
        <span class="row-name">
          <b></b> <span class="row-country"></span>
        </span>
        <span class="fit"></span>
        <span class="row-tagline"></span>
        <span class="bar">
          <span></span>
        </span>
      </summary>
    </details>
  </li>
</template>

<template id="detail-template">
  <div class="detail-body">
    <div class="field" data-field="portrait">
      <h4 class="portrait-title"></h4>
      <ul class="portrait"></ul>
    </div>
    <div class="field" data-field="reputation">
      <span class="eyebrow">{copy.said}</span>
      <p class="quote"></p>
    </div>
    <div class="field" data-field="surprise">
      <h4>{copy.surprise}</h4>
      <p></p>
    </div>
    <div class="field" data-field="neighbourhoods">
      <h4>{copy.neighbourhoods}</h4>
      <ul class="places"></ul>
      <p class="small">{copy.rents}</p>
    </div>
    <div class="field" data-field="reasons">
      <h4>{copy.strengths}</h4>
      <ul class="reasons"></ul>
    </div>
    <div class="field watch" data-field="watch">
      <h4>{copy.watch}</h4>
      <p></p>
    </div>
    <div class="field watch" data-field="advisory">
      <h4>{copy.advisory}</h4>
      <p></p>
    </div>
    {/* Every city of the result leads to its reactions (operator, 2026-11-18). */}
    <a class="field full" data-field="reactions" hidden={!reactions}></a>
    <a class="field full" data-field="full">
      {copy.full}
    </a>
  </div>
</template>

<style is:global>
  .cards,
  .rows {
    display: grid;
    gap: 12px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }
  .results .card {
    background: var(--night-deep);
    border: 1px solid var(--night-lift);
    border-radius: 18px;
    padding: 18px;
    display: grid;
    gap: 10px;
  }
  /* The city in first place: framed in saffron, bigger, with its "pourquoi vous" open. */
  .results .card.first {
    border: 2px solid var(--saffron);
    gap: 14px;
  }
  /* The first city in one screen or so (operator, 2026-11-27, mockup C1): its photo first, with
     the rank on it, the score and its two bars, the one-tap reaction, a review and the one filled
     button. The rest waits in « Voir le détail ». */
  .results .card.first .photo {
    order: -1;
    position: relative;
    overflow: hidden;
    border-radius: 14px;
  }
  .results .card.first .photo img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .results .card.first .photo figcaption {
    position: absolute;
    inset: auto 0 0;
    margin: 0;
    padding: 18px 10px 6px;
    background: linear-gradient(transparent, var(--night-deep));
    color: var(--thread);
    font-size: 0.68rem;
  }
  .results .card.first:has(> .photo:not([hidden])) {
    position: relative;
    .card-head {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .rank {
      position: absolute;
      z-index: 1;
      top: 28px;
      left: 28px;
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--saffron);
      color: var(--ink);
      font-size: 1.3rem;
    }
  }
  .results .card.first:not(:has(> .detail[open])) {
    :is(.why-temper, .card-pitch, .rated, .facts, .same, .not-for-me, .keep-more) {
      display: none;
    }
  }
  .results .card-head,
  .rows .row-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: 12px;
    align-items: center;
  }
  .results .rank {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.8rem;
    line-height: 1;
    color: var(--saffron);
  }
  .results .first .rank,
  .results .first h3 {
    font-size: clamp(2.2rem, 10vw, 2.8rem);
  }
  .results h3 {
    font-family: var(--font-display);
    font-size: 1.45rem;
    margin: 0;
    line-height: 1.05;
  }
  .results .discover {
    display: inline-block;
    margin-top: 4px;
    padding: 1px 10px;
    border: 1px solid var(--saffron);
    border-radius: 999px;
    color: var(--saffron);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .results .discover[hidden] {
    display: none;
  }
  .results .card-country,
  .results .card-tagline {
    margin: 0;
    color: var(--thread-dim);
    font-size: 0.85rem;
  }
  /* Cards 2 and 3 only (reactions-dom showCounts): the first one carries the preview itself. */
  .results .card-reactions {
    display: inline-block;
    margin-top: 4px;
    color: var(--saffron);
    font-size: 0.85rem;
    font-weight: 700;
    text-underline-offset: 3px;
  }
  /* Beside « À découvrir » the link touched the badge's border. */
  .results .discover:not([hidden]) + .card-reactions {
    margin-left: 8px;
  }
  .results .card-reactions[hidden] {
    display: none;
  }
  .results .card-tagline,
  .rows .row-tagline {
    font-family: var(--font-mono);
    color: var(--saffron);
    font-size: 0.85rem;
  }
  .results .fit,
  .rows .fit {
    font-family: var(--font-mono);
    color: var(--saffron);
  }
  .results .card-pitch {
    margin: 0;
    font-size: 0.95rem;
  }
  .results .bar,
  .rows .bar {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: var(--night-lift);
    overflow: hidden;
  }
  .results .bar > span,
  .rows .bar > span {
    display: block;
    height: 100%;
    background: var(--saffron);
    border-radius: 999px;
  }
  .results .portrait-box[hidden] {
    display: none;
  }
  .results .portrait-box {
    background: var(--night-lift);
    border-radius: 14px;
    padding: 14px;
    display: grid;
    gap: 10px;
  }
  .results h4,
  .rows h4 {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
  }
  .results .portrait-title,
  .rows .portrait-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .results .portrait,
  .rows .portrait {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .results .portrait li,
  .rows .portrait li {
    display: grid;
    gap: 2px;
    padding-left: 12px;
    border-left: 3px solid var(--saffron);
  }
  .results .said,
  .rows .said {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--thread-dim);
  }
  /* The cards' pill; a row's summary is the whole row. */
  .results .card > details.detail > summary {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 2px solid var(--thread);
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.92rem;
    cursor: pointer;
    list-style: none;
  }
  details.detail > summary::-webkit-details-marker {
    display: none;
  }
  details.detail:not([open]) .when-open,
  details.detail[open] .when-closed {
    display: none;
  }
  .results details.detail {
    display: grid;
    gap: 14px;
  }
  .detail-body {
    display: grid;
    gap: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--night-pressed);
    font-size: 0.95rem;
  }
  .detail-body .field {
    display: grid;
    gap: 6px;
  }
  .detail-body p {
    margin: 0;
  }
  .detail-body .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--saffron);
  }
  .detail-body .quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.35;
  }
  .detail-body .places {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .detail-body .places li {
    background: var(--night);
    border-radius: 10px;
    padding: 8px 12px;
  }
  .detail-body .small,
  .detail-body .sources {
    font-size: 0.8rem;
    color: var(--thread-dim);
  }
  .detail-body .reasons {
    margin: 0;
    padding-left: 1.1em;
  }
  .detail-body .watch {
    border: 2px solid var(--coral);
    border-radius: 14px;
    padding: 12px 14px;
  }
  .detail-body .watch h4 {
    color: var(--coral);
  }
  .detail-body .sources summary {
    cursor: pointer;
  }
  .detail-body .sources ul {
    margin: 6px 0 0;
    padding-left: 1.1em;
  }
  .detail-body a {
    color: var(--saffron);
  }
  .rows .row {
    border-bottom: 1px solid var(--night-lift);
    padding: 12px 0;
  }
  .rows .row-head {
    grid-template-columns: 32px minmax(0, 1fr) auto;
    row-gap: 6px;
  }
  .rows summary.row-head {
    cursor: pointer;
    list-style: none;
    min-height: 44px;
  }
  /* « Tout près derrière », 4 to 10 (operator, 2026-11-27, mockup RA): one line per city, name,
     country, score and a chevron, the bar under it; no tagline, so each city stays one line. */
  .near .row-tagline {
    display: none;
  }
  .near .rows .fit::after {
    content: " ›";
    color: var(--thread-dim);
  }
  .rows .rank {
    font-family: var(--font-mono);
    color: var(--saffron);
    font-size: 0.9rem;
  }
  .rows .row-country {
    color: var(--thread-dim);
  }
  .rows .row-tagline,
  .rows .bar,
  .rows .row-note {
    grid-column: 2 / -1;
  }
  .rows .row-tagline {
    color: var(--thread-dim);
    font-family: var(--font-body);
  }
  .rows .detail-body {
    margin-top: 12px;
    background: var(--night-deep);
    border: 0;
    border-radius: 14px;
    padding: 14px;
  }
  .results .photo {
    margin: 0;
  }
  .results .photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 14px;
    display: block;
  }
  .results .photo figcaption {
    font-size: 0.75rem;
    color: var(--thread-dim);
    margin-top: 4px;
  }
  /* Result cards: same fields for each city, reasons rated 1 to 5. */
  .results .card .fit {
    text-align: right;
  }
  .results .card .fit b {
    display: block;
    font-size: 1.8rem;
    line-height: 1;
  }
  .results .card .fit small {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--thread-dim);
  }
  /* Why the temperament part: the neighbourhoods at the reader's level. */
  .results .why-temper {
    margin: 0;
    padding-left: 1.1em;
    font-size: 0.88rem;
    color: var(--thread-dim);
  }
  .results .why-temper .weak {
    color: var(--coral);
  }
  .results .why-temper:empty {
    display: none;
  }
  .results .same {
    margin: 0;
    font-size: 0.9rem;
    color: var(--thread-dim);
  }
  .results .go:not([hidden]) {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 12px;
    padding: 0 22px;
    border-radius: 999px;
    border: 2px solid var(--saffron);
    color: var(--saffron);
    font-weight: 700;
    text-decoration: none;
  }
  .results .taps-ask {
    margin: 0;
    font-weight: 800;
  }
  .results .taps-ask[hidden] {
    display: none;
  }
  .results .first :global(.taps button) {
    border-width: 2px;
    border-color: var(--saffron);
  }
  /* The invitation arrives after a tap (operator, 2026-11-22): it rises in, a saffron stroke runs
     under the question as if underlined by hand, then the filled button below pulses twice. One
     sequence, about 2 s, played when the invitation appears; none with reduced motion
     (global.css). */
  .results .invite:not([hidden]) {
    display: grid;
    gap: 4px;
    animation: invite-rise 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .results .invite p {
    margin: 0;
  }
  .results .invite-line {
    font-weight: 800;
    font-size: 1.05rem;
  }
  .results .invite-ask {
    padding-bottom: 2px;
    background: linear-gradient(var(--saffron), var(--saffron)) left bottom / 100% 3px no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    animation: invite-stroke 650ms 300ms cubic-bezier(0.6, 0, 0.2, 1) both;
  }
  .results .invite-why {
    animation: invite-rise 420ms 180ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .results .card:has(.invite:not([hidden])) [data-hook-review] {
    animation: invite-call 900ms 900ms ease-out 2;
  }
  @keyframes invite-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes invite-stroke {
    from {
      background-size: 0% 3px;
    }
  }
  @keyframes invite-call {
    0% {
      box-shadow: 0 0 0 0 var(--saffron);
      transform: scale(1);
    }
    30% {
      transform: scale(1.03);
    }
    100% {
      box-shadow: 0 0 0 14px transparent;
      transform: scale(1);
    }
  }
  .results .invite-why {
    color: var(--thread-dim);
    font-size: 0.9rem;
  }
  .results .not-for-me:not([hidden]) {
    justify-self: start;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 2px solid var(--thread-dim);
    background: transparent;
    color: var(--thread);
    font-weight: 700;
    cursor: pointer;
  }
  /* « Façon de vivre » and « Vie pratique » as two bars (operator, 2026-11-27, mockup C1). */
  .results .split {
    display: grid;
    gap: 8px;
  }
  .results .score-line {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) 3rem;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
  }
  .results .score-line .bar {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: var(--night-lift);
    overflow: hidden;
  }
  .results .score-line .bar > span {
    display: block;
    height: 100%;
    background: var(--saffron);
  }
  .results .score-line b {
    color: var(--saffron);
    text-align: right;
  }
  .results .rated h4 {
    margin: 0 0 6px;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--thread-dim);
  }
  .results .rated ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .results .rated li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .results .rated[hidden] {
    display: none;
  }
  .results .pips {
    display: inline-flex;
    gap: 3px;
    flex: none;
  }
  .results .pips i {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: var(--night-lift);
  }
  .results .pips i.on {
    background: var(--saffron);
  }
  .results .against .pips i.on {
    background: var(--coral);
  }
  .results .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .results .facts li {
    background: var(--night-lift);
    border-radius: 999px;
    padding: 4px 11px;
    font-size: 0.82rem;
  }

  /* The score bar shows on the compact cards only. */
  .results .card .fit .bar {
    display: none;
  }
  .results .card .bar {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: var(--night-lift);
    overflow: hidden;
  }
  .results .card .bar > span {
    display: block;
    height: 100%;
    background: var(--saffron);
  }

  /* Cards 2 and 3 one under the other, compact (operator, 2026-11-27, mockup RA): the city's
     photo on the left with its rank, and beside it the name, the score, the one-tap reaction as
     round icons and « Détail ». « Voir le détail » opens the whole card, « Pas pour moi » with
     it. The taps and « Détail » sit beside the photo, so nothing leaves an empty space under it. */
  .results .card:not(.first):not(:has(> .detail[open])) {
    position: relative;
    grid-template-columns: 132px auto minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: 12px;
    row-gap: 8px;
    padding: 10px;
    border-radius: 16px;
    :is(
      .split,
      .why-temper,
      .card-pitch,
      .rated,
      .facts,
      .same,
      .go,
      .card-reactions,
      .not-for-me,
      .taps-note,
      figcaption
    ) {
      display: none;
    }
    .photo {
