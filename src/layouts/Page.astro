---
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";
import Analytics from "../components/Analytics.astro";
import ShareMeta from "../components/ShareMeta.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import { BRAND, LANGUAGE_TAG, type Bilingual } from "../i18n/locale";
import { localeOfPath, pathFor } from "../i18n/routes";

interface Props {
  title: string;
  description: string;
  /** Private pages (/admin) stay out of search engines. */
  noindex?: boolean;
  /** The admin is French only (operator, 2026-11-18): no language switch there. */
  monolingual?: boolean;
}
const { title, description, noindex = false, monolingual = false } = Astro.props;
const accounts = Boolean(import.meta.env.PUBLIC_NEWSLETTER);
const locale = localeOfPath(Astro.url.pathname);
const brand = BRAND[locale];
const COPY: Bilingual<Record<string, string>> = {
  fr: {
    home: "Là-bas, retour au quiz",
    shortcuts: "Raccourcis",
    space: "Mon espace",
    retake: "Refaire le quiz",
    pages: "Pages du site",
    cities: "Les villes",
    reviews: "Les avis",
    deep: "Aller plus loin",
    method: "Notre méthode",
    legal: "Mentions légales",
    privacy: "Confidentialité",
  },
  en: {
    home: "Over There, back to the quiz",
    shortcuts: "Shortcuts",
    space: "My space",
    retake: "Take the quiz again",
    pages: "Site pages",
    cities: "The cities",
    reviews: "Reviews",
    deep: "Go deeper",
    method: "Our method",
    legal: "Legal notice",
    privacy: "Privacy",
  },
};
const copy = COPY[locale];
const to = (route: Parameters<typeof pathFor>[0]) => pathFor(route, locale);
---

<html lang={LANGUAGE_TAG[locale].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <ShareMeta title={`${title} · ${brand}`} description={description} />
    <meta name="theme-color" content="#161a5c" />
    <title>{title} · {brand}</title>
    <Analytics />
  </head>
  <body>
    <div class="page">
      <header class="top">
        <a href={to("home")} class="home" aria-label={copy.home}>
          <Wordmark />
        </a>
        <nav class="top-links" aria-label={copy.shortcuts}>
          {accounts && <a href={to("space")}>{copy.space}</a>}
          <a href={to("home")} class="back">
            {copy.retake}
          </a>
          {!monolingual && <LanguageSwitch />}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="bottom">
        <nav aria-label={copy.pages}>
          {accounts && <a href={to("space")}>{copy.space}</a>}
          <a href={to("cities")}>{copy.cities}</a>
          {accounts && <a href={to("reviews")}>{copy.reviews}</a>}
          <a href={to("deep")}>{copy.deep}</a>
          <a href={to("method")}>{copy.method}</a>
          <a href={to("legal")}>{copy.legal}</a>
          <a href={to("privacy")}>{copy.privacy}</a>
          {!monolingual && <LanguageSwitch />}
        </nav>
      </footer>
    </div>
  </body>
</html>

<style>
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 max(16px, env(safe-area-inset-right)) 56px max(16px, env(safe-area-inset-left));
    display: grid;
    gap: 28px;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    border-bottom: 1px solid var(--night-lift);
    font-size: 1.6rem;
  }
  .home {
    color: var(--thread);
    text-decoration: none;
  }
  .top-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 16px;
  }
  .top-links a,
  .back,
  .bottom a {
    color: var(--saffron);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .bottom {
    border-top: 1px solid var(--night-lift);
    padding-top: 20px;
  }
  .bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }
  main :global(h1) {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3rem);
    line-height: 1.05;
    margin: 0 0 12px;
  }
  main :global(h2) {
    font-family: var(--font-display);
    font-size: 1.45rem;
    margin: 28px 0 8px;
  }
  main :global(h3) {
    font-size: 1.05rem;
    margin: 18px 0 6px;
  }
  main :global(p),
  main :global(li) {
    max-width: 68ch;
  }
  main :global(a) {
    color: var(--saffron);
  }
  main :global(.lead) {
    color: var(--thread-dim);
    font-size: 1.05rem;
  }
</style>
