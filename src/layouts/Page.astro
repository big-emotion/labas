---
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";
import Analytics from "../components/Analytics.astro";
import ShareMeta from "../components/ShareMeta.astro";

interface Props {
  title: string;
  description: string;
  /** Private pages (/admin) stay out of search engines. */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const accounts = Boolean(import.meta.env.PUBLIC_NEWSLETTER);
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <ShareMeta title={`${title} · Là-bas`} description={description} />
    <meta name="theme-color" content="#161a5c" />
    <title>{title} · Là-bas</title>
    <Analytics />
  </head>
  <body>
    <div class="page">
      <header class="top">
        <a href="/" class="home" aria-label="Là-bas, retour au quiz">
          <Wordmark />
        </a>
        <nav class="top-links" aria-label="Raccourcis">
          {accounts && <a href="/espace/">Mon espace</a>}
          <a href="/" class="back">
            Refaire le quiz
          </a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="bottom">
        <nav aria-label="Pages du site">
          {accounts && <a href="/espace/">Mon espace</a>}
          <a href="/villes/">Les villes</a>
          {accounts && <a href="/avis/">Les avis</a>}
          <a href="/approfondir">Aller plus loin</a>
          <a href="/methode">Notre méthode</a>
          <a href="/mentions-legales">Mentions légales</a>
          <a href="/confidentialite">Confidentialité</a>
        </nav>
      </footer>
    </div>
  </body>
</html>

<style>
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 max(16px, env(safe-area-inset-right)) 56px max(16px, env(safe-area-inset-left));
    display: grid;
    gap: 28px;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    border-bottom: 1px solid var(--night-lift);
    font-size: 1.6rem;
  }
  .home {
    color: var(--thread);
    text-decoration: none;
  }
  .top-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 16px;
  }
  .top-links a,
  .back,
  .bottom a {
    color: var(--saffron);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .bottom {
    border-top: 1px solid var(--night-lift);
    padding-top: 20px;
  }
  .bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }
  main :global(h1) {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3rem);
    line-height: 1.05;
    margin: 0 0 12px;
  }
  main :global(h2) {
    font-family: var(--font-display);
    font-size: 1.45rem;
    margin: 28px 0 8px;
  }
  main :global(h3) {
    font-size: 1.05rem;
    margin: 18px 0 6px;
  }
  main :global(p),
  main :global(li) {
    max-width: 68ch;
  }
  main :global(a) {
    color: var(--saffron);
  }
  main :global(.lead) {
    color: var(--thread-dim);
    font-size: 1.05rem;
  }
</style>
