---
import Page from "../layouts/Page.astro";
import Reactions from "../components/Reactions.astro";
import { cityCopy } from "../i18n/city-copy";
import { BRAND, type Bilingual } from "../i18n/locale";
import { zoneName } from "../i18n/places";
import { localeOfPath, pathFor } from "../i18n/routes";
import { CITIES, ZONES, type Zone } from "../lib/cities";
import { photoFor } from "../lib/photos";
import { temperamentName, temperamentText } from "../lib/reactions";
import { SORTS, type Place } from "../lib/review-search";
import { TEMPERAMENTS } from "../lib/temperament";

/**
 * The reviews of every city (operator, 2026-11-18): another way in than the quiz. Anyone reads;
 * replying and marking need a space. A region, then one of its cities, a sort and a temperament
 * filter the list in the browser, twenty a page; a city chosen shows its card above the reviews.
 * Built at /avis/ and /en/reviews/; the reviews themselves stay in the language they were written.
 */
const locale = localeOfPath(Astro.url.pathname);
const places: Record<string, Place> = Object.fromEntries(
  CITIES.map((c) => {
    const { name, country } = cityCopy(c, locale);
    return [c.slug, { slug: c.slug, name, country, zone: c.zone }];
  }),
);
/** What the city card shows: the top of the city page, so the reader knows where they are. */
const cards = Object.fromEntries(
  CITIES.map((c) => {
    const photo = photoFor(c.name);
    const { tagline, pitch } = cityCopy(c, locale);
    return [
      c.slug,
      {
        tagline,
        pitch,
        region: zoneName(c.zone, locale),
        photo: photo && {
          src: `/photos/${photo.file}`,
          alt: photo.alt,
          credit:
            locale === "en"
              ? `Photo: ${photo.author}, ${photo.license}, via Wikimedia Commons.`
              : `Photo : ${photo.author}, ${photo.license}, via Wikimedia Commons.`,
        },
      },
    ];
  }),
);
const temperaments = TEMPERAMENTS.map((t) => ({
  key: t.name,
  name: temperamentName(t.name, locale),
  text: temperamentText(t.name, t.text, locale),
}));
const enabled = Boolean(import.meta.env.PUBLIC_NEWSLETTER);

const COPY = {
  fr: {
    title: "Les avis sur les villes",
    description: `Ce que les lecteurs de ${BRAND.fr} disent des villes d'Afrique qu'ils connaissent : cherchez par ville, par région ou par tempérament.`,
    heading: "Les avis",
    lead: "Ce que les lecteurs disent des villes d'Afrique qu'ils connaissent ou qui les attirent. Choisissez une région puis une ville, ou cherchez un mot.",
    filters: "Filtrer les avis",
    search: "Chercher",
    searchPlaceholder: "Une ville, un pays, un mot",
    region: "Région",
    allAfrica: "Toute l'Afrique",
    city: "Ville",
    allCities: "Toutes les villes de la région",
    sort: "Trier",
    tapped: "Villes avec réactions",
    alike: "Des gens qui vous ressemblent",
    everyone: "Tout le monde",
    temperamentHint:
      "Choisissez un tempérament : les avis de personnes aux préférences proches passent devant. Inspiré du Big Five, ce n'est pas un test de personnalité.",
    bigFive: "Inspiré du Big Five, ce n'est pas un test de personnalité.",
    seePage: "Voir la page",
    pages: "Pages des avis",
    page: "Page",
    previous: "Précédent",
    next: "Suivant",
    giveBefore: "Pour donner votre avis, ouvrez la page d'une ville dans",
    cityList: "la liste des villes",
    or: ", ou",
    takeQuiz: "faites le quiz",
    giveAfter: "pour trouver les vôtres.",
    closed: "Les avis ne sont pas disponibles pour l'instant.",
  },
  en: {
    title: "Reviews of the cities",
    description: `What ${BRAND.en} readers say about the African cities they know: search by city, by region or by temperament.`,
    heading: "Reviews",
    lead: "What readers say about the African cities they know or that draw them. Pick a region, then a city, or search for a word.",
    filters: "Filter the reviews",
    search: "Search",
    searchPlaceholder: "A city, a country, a word",
    region: "Region",
    allAfrica: "All of Africa",
    city: "City",
    allCities: "Every city in the region",
    sort: "Sort",
    tapped: "Cities with reactions",
    alike: "People like you",
    everyone: "Everyone",
    temperamentHint:
      "Pick a temperament: reviews from people with similar preferences come first. Inspired by the Big Five; it is not a personality test.",
    bigFive: "Inspired by the Big Five; it is not a personality test.",
    seePage: "See the page",
    pages: "Review pages",
    page: "Page",
    previous: "Previous",
    next: "Next",
    giveBefore: "To give your review, open a city's page from",
    cityList: "the list of cities",
    or: ", or",
    takeQuiz: "take the quiz",
    giveAfter: "to find yours.",
    closed: "Reviews are not available for now.",
  },
} satisfies Bilingual<Record<string, string>>;
const copy = COPY[locale];
/** What the browser script needs to write, in the page's language. */
const scriptCopy = {
  allCities: copy.allCities,
  bigFive: copy.bigFive,
  page: copy.page,
  previous: copy.previous,
  next: copy.next,
};
const zones = Object.keys(ZONES) as Zone[];
---

<Page title={copy.title} description={copy.description}>
  <h1>{copy.heading}</h1>
  <p class="lead">{copy.lead}</p>

  {enabled ? (
    <div
      class="space"
      data-avis
      data-places={JSON.stringify(places)}
      data-cards={JSON.stringify(cards)}
      data-temperaments={JSON.stringify(temperaments)}
      data-copy={JSON.stringify(scriptCopy)}
    >
      <form class="filters" data-filters role="search" aria-label={copy.filters}>
        <label class="search">
          <span>{copy.search}</span>
          <input type="search" name="q" placeholder={copy.searchPlaceholder} autocomplete="off" />
        </label>

        <fieldset>
          <legend>{copy.region}</legend>
          <div class="chips">
            <label>
              <input type="radio" name="zone" value="" checked />
              <span>{copy.allAfrica}</span>
            </label>
            {zones.map((zone) => (
              <label>
                <input type="radio" name="zone" value={zone} />
                <span>{zoneName(zone, locale)}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="pick" data-city-pick hidden>
          <span>{copy.city}</span>
          <select name="ville">
            <option value="">{copy.allCities}</option>
          </select>
        </label>

        <label class="pick">
          <span>{copy.sort}</span>
          <select name="tri">
            {SORTS.map((sort) => (
              <option value={sort.key}>{sort.label[locale]}</option>
            ))}
          </select>
        </label>

        <label class="check">
          <input type="checkbox" name="avec" />
          <span>{copy.tapped}</span>
        </label>

        <fieldset>
          <legend>{copy.alike}</legend>
          <div class="chips">
            <label>
              <input type="radio" name="temperament" value="" checked />
              <span>{copy.everyone}</span>
            </label>
            {temperaments.map((t) => (
              <label title={t.text}>
                <input type="radio" name="temperament" value={t.key} />
                <span>{t.name}</span>
              </label>
            ))}
          </div>
          <p class="hint" data-temperament-text>
            {copy.temperamentHint}
          </p>
        </fieldset>
      </form>

      <article class="city-card" data-city-card aria-labelledby="city-card-name" hidden>
        <figure class="city-photo" data-card-photo hidden>
          <img alt="" width="640" height="360" loading="lazy" decoding="async" />
          <figcaption />
        </figure>
        <div class="city-body">
          <p class="city-where" data-card-where />
          <h2 id="city-card-name" data-card-name />
          <p class="city-tagline" data-card-tagline />
          <p class="city-pitch" data-card-pitch />
          <a class="city-link" data-card-link href={pathFor("cities", locale)}>
            {copy.seePage}
          </a>
        </div>
      </article>

      <Reactions everywhere />

      <nav class="pages" data-pages aria-label={copy.pages} hidden />

      <p class="give">
        {copy.giveBefore} <a href={pathFor("cities", locale)}>{copy.cityList}</a>
        {copy.or} <a href={pathFor("home", locale)}>{copy.takeQuiz}</a> {copy.giveAfter}
      </p>
    </div>
  ) : (
    <p>{copy.closed}</p>
  )}
</Page>

<script>
  import { pageLocale } from "../i18n/locale";
  import { pathFor } from "../i18n/routes";
  import { mountEverywhere } from "../lib/reactions-dom";
  import { ofCity, type Reaction } from "../lib/reactions";
  import {
    citiesOfZone,
    pageLinks,
    pageOf,
    searchReviews,
    SORTS,
    type Place,
    type ReviewSort,
  } from "../lib/review-search";
  import type { Zone } from "../lib/cities";
  import { loadTaps } from "../lib/taps-dom";

  const locale = pageLocale();

  interface Card {
    tagline: string;
    pitch: string;
    region: string;
    photo?: { src: string; alt: string; credit: string };
  }

  async function start(space: HTMLElement, root: HTMLElement) {
    const places = JSON.parse(space.dataset.places!) as Record<string, Place>;
    const cards = JSON.parse(space.dataset.cards!) as Record<string, Card>;
    const temperaments = JSON.parse(space.dataset.temperaments!) as {
      key: string;
      text: string;
    }[];
    const copy = JSON.parse(space.dataset.copy!) as Record<
      "allCities" | "bigFive" | "page" | "previous" | "next",
      string
    >;
    const form = space.querySelector<HTMLFormElement>("[data-filters]")!;
    const cityPick = space.querySelector<HTMLElement>("[data-city-pick]")!;
    const citySelect = cityPick.querySelector("select")!;
    const card = space.querySelector<HTMLElement>("[data-city-card]")!;
    const pages = space.querySelector<HTMLElement>("[data-pages]")!;
    const temperamentText = space.querySelector<HTMLElement>("[data-temperament-text]")!;
    const defaultText = temperamentText.textContent!;
    let loaded: Reaction[] = [];

    // The filters and the page live in the address: a filtered list can be shared or come back to.
    const params = new URLSearchParams(location.search);
    let page = Number(params.get("page") ?? "1");
    const wanted = places[params.get("ville") ?? ""] ? params.get("ville")! : "";
    form.q.value = params.get("q") ?? "";
    const pick = (name: string, value: string | null) => {
      const input = form.querySelector<HTMLInputElement>(
        `input[name="${name}"][value="${CSS.escape(value ?? "")}"]`,
      );
      if (input) input.checked = true;
    };
    // A city given in the address brings its region with it, so the list shows it chosen.
    pick("zone", wanted ? places[wanted].zone : params.get("region"));
    pick("temperament", params.get("temperament"));
    const tri = params.get("tri");
    if (SORTS.some((s) => s.key === tri)) form.tri.value = tri;
    form.avec.checked = params.has("avec");
    // The cities' public reactions order and filter the reviews; none without the service.
    const taps = await loadTaps();

    const zoneOf = () => (String(new FormData(form).get("zone") ?? "") || null) as Zone | null;

    /** The city list follows the region: hidden for all of Africa, rebuilt with the counts. */
    function fillCities(keep: string) {
      const zone = zoneOf();
      cityPick.hidden = !zone;
      const options = zone
        ? citiesOfZone(loaded, places, zone).map((c) => {
            const option = new Option(`${c.name} (${c.count})`, c.slug);
            return option;
          })
        : [];
      citySelect.replaceChildren(new Option(copy.allCities, ""), ...options);
      citySelect.value = zone && places[keep]?.zone === zone ? keep : "";
    }

    const filters = () => {
      const data = new FormData(form);
      return {
        query: String(data.get("q") ?? ""),
        city: String(data.get("ville") ?? "") || null,
        zone: zoneOf(),
        temperament: String(data.get("temperament") ?? "") || null,
        sort: (String(data.get("tri") ?? "") || "recents") as ReviewSort,
        taps,
        tapped: data.has("avec"),
      };
    };

    function remember(at: number) {
      const { query, city, zone, temperament, sort, tapped } = filters();
      const next = new URLSearchParams();
      if (city) next.set("ville", city);
      else if (zone) next.set("region", zone);
      if (query.trim()) next.set("q", query.trim());
      if (temperament) next.set("temperament", temperament);
      if (sort !== "recents") next.set("tri", sort);
      if (tapped) next.set("avec", "1");
      if (at > 1) next.set("page", String(at));
      const search = next.toString();
      history.replaceState(null, "", search ? `?${search}` : location.pathname);
    }

    function showCard(city: string | null) {
      card.hidden = !city;
      if (!city) return;
      const place = places[city];
      const about = cards[city];
      card.querySelector("[data-card-where]")!.textContent = `${place.country} · ${about.region}`;
      card.querySelector("[data-card-name]")!.textContent = place.name;
      card.querySelector("[data-card-tagline]")!.textContent = about.tagline;
      card.querySelector("[data-card-pitch]")!.textContent = about.pitch;
      const link = card.querySelector<HTMLAnchorElement>("[data-card-link]")!;
      link.href = pathFor("city", locale, city);
      link.textContent =
        locale === "en" ? `See the ${place.name} page` : `Voir la page ${ofCity(place.name)}`;
      const figure = card.querySelector<HTMLElement>("[data-card-photo]")!;
      figure.hidden = !about.photo;
      if (about.photo) {
        const img = figure.querySelector("img")!;
        img.src = about.photo.src;
        img.alt = about.photo.alt;
        figure.querySelector("figcaption")!.textContent = about.photo.credit;
      }
    }

    function showPages(current: number, total: number) {
      pages.hidden = total <= 1;
      const button = (label: string, to: number, extra: Partial<HTMLButtonElement> = {}) => {
        const b = Object.assign(document.createElement("button"), {
          type: "button",
          textContent: label,
          ...extra,
        });
        b.addEventListener("click", () => {
          page = to;
          redraw(false);
          root.scrollIntoView({ behavior: "smooth", block: "start" });
        });
        return b;
      };
      const items = pageLinks(current, total).map((n) => {
        if (n === "…") return Object.assign(document.createElement("span"), { textContent: "…" });
        const b = button(String(n), n);
        b.setAttribute("aria-label", `${copy.page} ${n}`);
        if (n === current) b.setAttribute("aria-current", "page");
        return b;
      });
      pages.replaceChildren(
        button(copy.previous, current - 1, { disabled: current <= 1 }),
        ...items,
        button(copy.next, current + 1, { disabled: current >= total }),
      );
    }

    const list = await mountEverywhere(root, {
      places,
      select: (reactions) => {
        const found = searchReviews(reactions, places, filters());
        const shown = pageOf(found, page);
        page = shown.page;
        showPages(shown.page, shown.pages);
        remember(shown.page);
        return { shown: shown.items, total: found.length };
      },
      temperament: () => filters().temperament,
      onDraw(reactions) {
        loaded = reactions;
        showCard(filters().city);
        const chosen = temperaments.find((t) => t.key === filters().temperament);
        temperamentText.textContent = chosen ? `${chosen.text} ${copy.bigFive}` : defaultText;
      },
    });
    if (!list.loaded) {
      space.hidden = true;
      return;
    }
    // The counts need the reviews: the city list is built once they are here.
    fillCities(wanted);
    list.redraw();

    function redraw(fromFilters: boolean) {
      // A new filter starts again at its first page.
      if (fromFilters) page = 1;
      list.redraw();
    }
    form.addEventListener("change", (event) => {
      if ((event.target as HTMLInputElement).name === "zone") fillCities("");
      redraw(true);
    });
    form.addEventListener("input", (event) => {
      if ((event.target as HTMLInputElement).name === "q") redraw(true);
    });
    form.addEventListener("submit", (event) => event.preventDefault());
  }

  const space = document.querySelector<HTMLElement>("[data-avis]");
  const root = document.querySelector<HTMLElement>('[data-reactions="everywhere"]');
  if (space && root) start(space, root);
</script>

<style>
  .space {
    display: grid;
    gap: 20px;
  }
  .space[hidden] {
    display: none;
  }
  .filters {
    display: grid;
    gap: 16px;
  }
  .search {
    display: grid;
    gap: 6px;
    font-weight: 700;
  }
  .search input {
    min-height: 48px;
    border-radius: 14px;
    border: 2px solid var(--thread-faint);
    background: var(--paper);
    color: var(--ink);
    padding: 10px 14px;
    font: inherit;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  legend {
    font-weight: 700;
    margin-bottom: 8px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips label {
    position: relative;
  }
  /* The radio stays in the page for the keyboard and screen readers; the chip is what shows. */
  .chips input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chips span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--thread-faint);
    color: var(--thread);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .chips input:checked + span {
    background: var(--saffron);
    border-color: var(--saffron);
    color: var(--ink);
  }
  .chips input:focus-visible + span {
    outline: 2px solid var(--saffron);
    outline-offset: 2px;
  }
  .hint {
    color: var(--thread-dim);
    font-size: 0.85rem;
    margin: 0;
  }
  .check {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-weight: 700;
  }
  .check input {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--saffron);
  }
  .pick {
    display: grid;
    gap: 6px;
    font-weight: 700;
  }
  .pick[hidden] {
    display: none;
  }
  .pick select {
    min-height: 48px;
    border-radius: 14px;
    border: 2px solid var(--thread-faint);
    background: var(--paper);
    color: var(--ink);
    padding: 0 12px;
    font: inherit;
    font-weight: 400;
  }
  .city-card {
    display: grid;
    gap: 12px;
    padding: 16px;
    border-radius: 18px;
    background: var(--night-deep);
    border: 1px solid var(--night-lift);
  }
  .city-card[hidden],
  .city-photo[hidden] {
    display: none;
  }
  .city-photo {
    margin: 0;
    display: grid;
    gap: 4px;
  }
  .city-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
  }
  .city-photo figcaption,
  .city-where {
    font-size: 0.8rem;
    color: var(--thread-dim);
    margin: 0;
  }
  .city-body {
    display: grid;
    gap: 6px;
  }
  .city-body h2 {
    margin: 0;
    font-size: 1.4rem;
  }
  .city-tagline {
    margin: 0;
    font-weight: 700;
    color: var(--saffron);
  }
  .city-pitch {
    margin: 0;
    color: var(--thread);
  }
  .city-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  /* From a tablet up, the photo sits beside the text. */
  @media (min-width: 768px) {
    .city-card:has(.city-photo:not([hidden])) {
      grid-template-columns: 2fr 3fr;
      align-items: start;
    }
  }
  .pages {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .pages[hidden] {
    display: none;
  }
  .pages :global(button) {
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--thread-faint);
    background: transparent;
    color: var(--thread);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .pages :global(button[aria-current="page"]) {
    background: var(--saffron);
    border-color: var(--saffron);
    color: var(--ink);
  }
  .pages :global(button:disabled) {
    opacity: 0.4;
    cursor: default;
  }
  .pages :global(span) {
    color: var(--thread-dim);
  }
  .give {
    color: var(--thread-dim);
  }
</style>
