          grid-template-columns: 128px minmax(0, 1fr);
          gap: 14px;
          align-items: center;
        }
      }
      .map-legend {
        margin: 0;
        color: var(--thread-dim);
        font-size: 0.85rem;
      }
      .map-side {
        display: grid;
        gap: 4px;
        min-width: 0;
      }
      .leaders {
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: leader;
        font-size: 1rem;
      }
      /* Built by the script, so outside Astro's scoped styles. */
      .leaders :global(li) {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        counter-increment: leader;
        font-weight: 700;
      }
      .leaders :global(li)::before {
        content: counter(leader);
        width: 16px;
        font-family: var(--font-display);
        font-weight: 900;
        color: var(--saffron);
      }
      .leaders :global(li span) {
        flex-grow: 1;
        min-width: 0;
        overflow-wrap: anywhere;
      }
      .leaders :global(.aside-button) {
        min-width: 44px;
        min-height: 44px;
        border-radius: 999px;
        border: 2px solid var(--night-pressed);
        background: transparent;
        color: var(--thread-dim);
        font-size: 1.25rem;
        line-height: 1;
        cursor: pointer;
      }
      .left-out {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        color: var(--thread-dim);
      }
      .left-out[hidden],
      .aside-notice[hidden] {
        display: none;
      }
      .left-out :global(.left-out-chip) {
        min-height: 40px;
        padding: 0 14px;
        border-radius: 999px;
        border: 2px solid var(--night-pressed);
        background: transparent;
        color: var(--thread);
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
      }
      /* Pinned above the feedback tab, so « Annuler » shows wherever the place was set aside. */
      .aside-notice {
        position: fixed;
        left: 16px;
        right: 16px;
        bottom: max(72px, calc(env(safe-area-inset-bottom) + 56px));
        z-index: 20;
        max-width: 560px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 8px 8px 16px;
        border-radius: 14px;
        border: 2px solid var(--saffron);
        background: var(--night-deep);
        font-size: 0.95rem;
      }
      .aside-notice span {
        flex-grow: 1;
      }
      .aside-notice button {
        min-height: 44px;
        padding: 0 14px;
        border: 0;
        background: transparent;
        color: var(--saffron);
        font-weight: 700;
        text-decoration: underline;
        cursor: pointer;
      }
      .sheet-options :global(.option b),
      .sheet-options :global(.option span) {
        display: block;
        font-family: var(--font-body);
        font-size: 1rem;
      }
      .sheet-options :global(.option:has(span)) {
        padding: 8px 14px;
      }
      .sheet-options :global(.option span) {
        font-weight: 400;
        font-size: 0.9rem;
      }
      .filters {
        display: grid;
        gap: 8px;
        margin-bottom: 20px;
      }
      .filter-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .filter-chip {
        min-height: 40px;
        padding: 0 14px;
        border-radius: 999px;
        border: 2px solid var(--night-pressed);
        background: transparent;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
      }
      .filter-chip[aria-pressed="true"] {
        background: var(--saffron);
        border-color: var(--saffron);
        color: var(--ink);
      }
      .sheet {
        margin: auto auto 0;
        width: 100%;
        max-width: 560px;
        max-height: 85vh;
        border: 0;
        border-radius: 22px 22px 0 0;
        padding: 0;
        background: var(--thread);
        color: var(--ink);
      }
      .sheet::backdrop {
        background: color-mix(in srgb, var(--scrim) 55%, transparent);
      }
      .sheet-body {
        display: grid;
        gap: 12px;
        padding: 20px 20px max(24px, env(safe-area-inset-bottom));
      }
      .sheet h2 {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.5rem;
      }
      .sheet-hint {
        margin: 0;
        font-size: 0.9rem;
      }
      .sheet-options {
        display: grid;
        gap: 8px;
        max-height: 50vh;
        overflow-y: auto;
      }
      /* Built by the script, so outside Astro's scoped styles. */
      .sheet-options :global(.option) {
        min-height: 48px;
        padding: 0 14px;
        border-radius: 14px;
        border: 2px solid var(--thread-faint);
        background: transparent;
        color: var(--ink);
        font-weight: 700;
        text-align: left;
        cursor: pointer;
      }
      .sheet-options :global(.option[aria-pressed="true"]) {
        background: var(--night);
        border-color: var(--night);
        color: var(--thread);
      }
      .sheet .primary {
        min-height: 52px;
        border: 0;
        border-radius: 999px;
        background: var(--night);
        color: var(--thread);
        font-weight: 800;
        cursor: pointer;
      }
      .progress {
        display: grid;
        gap: 10px;
      }
      .stitches {
        display: flex;
        gap: 3px;
      }
      .stitches :global(i) {
        flex: 1;
        height: 4px;
        border-radius: 2px;
        background: var(--night-lift);
      }
      .stitches :global(i.done) {
        background: var(--saffron);
      }
      .counter {
        margin: 0;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--thread-dim);
      }
      .counter :global(b) {
        color: var(--saffron);
      }
      .question legend {
        font-size: clamp(1.6rem, 6vw, 2.2rem);
      }
      .steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
      }
      .back,
      .next,
      .primary,
      .secondary {
        min-height: 44px;
        border-radius: 999px;
        font-weight: 800;
        cursor: pointer;
      }
      .back {
        border: 0;
        background: transparent;
        color: var(--thread-dim);
        padding: 0 4px;
        font-weight: 400;
        text-decoration: underline;
        text-underline-offset: 4px;
      }
      .back[hidden] {
        visibility: hidden;
        display: inline;
      }
      .next:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .next,
      .primary {
        border: 0;
        background: var(--saffron);
        color: var(--ink);
        padding: 0 22px;
      }
      .ready {
        display: grid;
        gap: 12px;
        background: var(--night-deep);
        border: 2px solid var(--saffron);
        border-radius: 20px;
        padding: 22px;
      }
      .ready[hidden],
      .outcome[hidden] {
        display: none;
      }
      .ready h2 {
        margin: 0;
      }
      .ready p {
        margin: 0;
      }
      .primary {
        min-height: 54px;
        font-size: 1.05rem;
      }
      .secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        border: 2px solid var(--thread);
        background: transparent;
        color: var(--thread);
        text-decoration: none;
      }
      .outcome {
        display: grid;
        gap: 40px;
      }
      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 18px;
      }
      .links a,
      :global(.detail-body .full) {
        color: var(--saffron);
        font-weight: 700;
      }
      .footer {
        display: grid;
        gap: 6px;
        font-size: 0.82rem;
      }

      /* The home screen (operator, 2026-11-26, mockup A3): one big tap centred under the map,
         cities lighting up while it waits. The quiz itself stays hidden until that tap. */
      .intro-screen {
        display: none;
      }
      :global(body.intro) .intro-screen {
        display: grid;
        gap: 14px;
        justify-items: stretch;
        text-align: center;
      }
      :global(body.intro) .progress,
      :global(body.intro) .questions,
      :global(body.intro) :global(.save-later) {
        display: none;
      }
      .intro-count {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 800;
      }
      .intro-start {
        position: relative;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 14px;
        min-height: 88px;
        border: 0;
        border-radius: 999px;
        background: var(--saffron);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 1.65rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 10px 36px var(--night-deep);
      }
      .intro-start:hover {
        filter: brightness(1.06);
      }
      /* A sheen crosses the button every few seconds; gone when motion is reduced. */
      .intro-start::after {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 30%;
        background: linear-gradient(
          90deg,
          transparent,
          color-mix(in srgb, var(--paper) 55%, transparent),
          transparent
        );
        animation: sheen 2.8s ease-in-out infinite;
      }
      @keyframes sheen {
        from {
          transform: translateX(-120%) skewX(-20deg);
        }
        60%,
        to {
          transform: translateX(380%) skewX(-20deg);
        }
      }
      .intro-note {
        margin: 0;
        color: var(--thread-dim);
        font-size: 0.92rem;
      }
      .intro-cities {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 48px;
        border-radius: 14px;
        background: var(--night-deep);
        color: var(--thread);
        font-weight: 700;
        text-decoration: none;
      }
      .intro-cities:hover {
        background: var(--night-lift);
      }
      /* Every fifth city lights up in turn: transform, not r, so Safari animates it too. */
      :global(body.intro) .map :global(.dot:nth-of-type(5n + 1)) {
        transform-box: fill-box;
        transform-origin: center;
        animation: twinkle 3.5s ease-in-out infinite;
      }
      :global(body.intro) .map :global(.dot:nth-of-type(10n + 6)) {
        animation-delay: 1.2s;
      }
      :global(body.intro) .map :global(.dot:nth-of-type(15n + 11)) {
        animation-delay: 2.3s;
      }
      @keyframes twinkle {
        0%,
        70%,
        100% {
          transform: scale(1);
        }
        80% {
          transform: scale(3);
          fill: var(--saffron);
          opacity: 1;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .intro-start::after {
          display: none;
        }
      }
      /* On the phone the map grows back to full width, and the lead gives way so the button
         sits mid-screen. */
      @media (max-width: 879px) {
        :global(body.intro) .maprow {
          display: block;
        }
        :global(body.intro) .map-side,
        :global(body.intro) .lead {
          display: none;
        }
        :global(body.intro) .map svg {
          max-height: 40vh;
        }
      }
      /* On a computer the map stays beside it, and the button is centred in its column. */
      @media (min-width: 880px) {
        :global(body.intro) .intro-screen {
          min-height: 60vh;
          align-content: center;
        }
      }

      /* « Voir mes villes maintenant »: a quiet way out, under the question (mockup, 2026-11-25). */
      .early {
        display: grid;
        gap: 10px;
        border-top: 1px solid var(--night-lift);
        padding-top: 16px;
      }
      .early[hidden] {
        display: none;
      }
      .early p {
        margin: 0;
        color: var(--thread-dim);
        font-size: 0.92rem;
      }
      .early-button {
        min-height: 52px;
        border-radius: 14px;
        border: 2px solid var(--saffron);
        background: transparent;
        color: var(--saffron);
        font-family: var(--font-body);
        font-size: 1.05rem;
        font-weight: 800;
        cursor: pointer;
      }
    </style>
  </body>
</html>
