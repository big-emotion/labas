      .stitches {
        display: flex;
        gap: 3px;
      }
      .stitches :global(i) {
        flex: 1;
        height: 4px;
        border-radius: 2px;
        background: var(--night-lift);
      }
      .stitches :global(i.done) {
        background: var(--saffron);
      }
      .counter {
        margin: 0;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--thread-dim);
      }
      .counter :global(b) {
        color: var(--saffron);
      }
      .question legend {
        font-size: clamp(1.6rem, 6vw, 2.2rem);
      }
      .steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
      }
      .back,
      .next,
      .primary,
      .secondary {
        min-height: 44px;
        border-radius: 999px;
        font-weight: 800;
        cursor: pointer;
      }
      .back {
        border: 0;
        background: transparent;
        color: var(--thread-dim);
        padding: 0 4px;
        font-weight: 400;
        text-decoration: underline;
        text-underline-offset: 4px;
      }
      .back[hidden] {
        visibility: hidden;
        display: inline;
      }
      .next:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .next,
      .primary {
        border: 0;
        background: var(--saffron);
        color: var(--ink);
        padding: 0 22px;
      }
      .ready {
        display: grid;
        gap: 12px;
        background: var(--night-deep);
        border: 2px solid var(--saffron);
        border-radius: 20px;
        padding: 22px;
      }
      .ready[hidden],
      .outcome[hidden] {
        display: none;
      }
      .ready h2 {
        margin: 0;
      }
      .ready p {
        margin: 0;
      }
      .primary {
        min-height: 54px;
        font-size: 1.05rem;
      }
      .secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        border: 2px solid var(--thread);
        background: transparent;
        color: var(--thread);
        text-decoration: none;
      }
      .outcome {
        display: grid;
        gap: 40px;
      }
      @media print {
        .further {
          display: none;
        }
      }
      .further {
        display: grid;
        gap: 12px;
        background: var(--saffron);
        color: var(--ink);
        border-radius: 20px;
        padding: 24px;
      }
      .further h2 {
        margin: 0;
      }
      .further p {
        margin: 0;
      }
      @media (max-width: 767px) {
        .further {
          padding: 16px;
        }
        .further h2 {
          font-size: 1.25rem;
        }
        .further p {
          display: none;
        }
      }
      .further a {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 52px;
        border-radius: 999px;
        background: var(--ink);
        color: var(--saffron);
        font-weight: 800;
        text-decoration: none;
      }
      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 18px;
      }
      .links a,
      :global(.detail-body .full) {
        color: var(--saffron);
        font-weight: 700;
      }
      .footer {
        display: grid;
        gap: 6px;
        font-size: 0.82rem;
      }
    </style>
  </body>
</html>
