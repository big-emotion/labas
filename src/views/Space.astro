---
import Page from "../layouts/Page.astro";
import { BRAND, type Bilingual } from "../i18n/locale";
import { localeOfPath, pathFor } from "../i18n/routes";

/** « Mon espace », built at /espace/ and /en/my-space/; the script reads its words from the page. */
const locale = localeOfPath(Astro.url.pathname);

const COPY = {
  fr: {
    title: "Mon espace",
    description: `Retrouvez vos parcours enregistrés sur ${BRAND.fr}, avec un lien de connexion par e-mail.`,
    lead: "Retrouvez vos parcours enregistrés. Pas de mot de passe : nous vous envoyons un lien de connexion.",
    email: "Votre e-mail",
    emailPlaceholder: "vous@exemple.fr",
    getLink: "Recevoir mon lien de connexion",
    checkInbox: "Regardez votre boîte e-mail.",
    linkComing:
      "Si un espace existe pour cette adresse, le lien arrive dans quelques minutes. Il marche 15 minutes, une seule fois.",
    journeys: "Mes parcours",
    noJourney: "Aucun parcours enregistré pour l'instant.",
    takeQuiz: "Faire le quiz",
    data: "Mes données",
    news: `Recevoir les nouveautés de ${BRAND.fr}`,
    download: "Télécharger mes données",
    deleteAll: "Supprimer mon espace et toutes mes réponses",
    logout: "Me déconnecter",
  },
  en: {
    title: "My space",
    description: `Find the journeys you saved on ${BRAND.en}, with a sign-in link by email.`,
    lead: "Find your saved journeys. No password: we send you a sign-in link.",
    email: "Your email",
    emailPlaceholder: "you@example.com",
    getLink: "Get my sign-in link",
    checkInbox: "Check your inbox.",
    linkComing:
      "If a space exists for this address, the link arrives within a few minutes. It works for 15 minutes, once.",
    journeys: "My journeys",
    noJourney: "No journey saved yet.",
    takeQuiz: "Take the quiz",
    data: "My data",
    news: `Get ${BRAND.en} news`,
    download: "Download my data",
    deleteAll: "Delete my space and all my answers",
    logout: "Sign out",
  },
} satisfies Bilingual<Record<string, string>>;
const copy = COPY[locale];

/** The words the browser script writes. */
const SCRIPT_COPY = {
  fr: {
    resume: "Reprendre",
    results: "Voir mes résultats",
    remove: "Supprimer",
    removeJourney: "Supprimer ce parcours ?",
    removeJourneyText:
      "Ses réponses et son résultat sont effacés tout de suite. On ne peut pas revenir en arrière.",
    keep: "Garder",
    signedInAs: "Connecté avec",
    keptUntil:
      "Vos parcours sont gardés jusqu'au {date}, trois ans après votre dernière visite. Ils ne sont jamais donnés à un partenaire.",
    checkAddress: "Vérifiez votre adresse, puis réessayez.",
    removeSpace: "Supprimer votre espace ?",
    removeSpaceText:
      "Votre adresse, tous vos parcours et toutes vos réponses sont effacés tout de suite, y compris votre inscription aux nouveautés. On ne peut pas revenir en arrière.",
    removeAll: "Tout supprimer",
    keepSpace: "Garder mon espace",
    removed: "Votre espace est supprimé.",
  },
  en: {
    resume: "Pick up",
    results: "See my results",
    remove: "Delete",
    removeJourney: "Delete this journey?",
    removeJourneyText:
      "Its answers and its result are erased straight away. This cannot be undone.",
    keep: "Keep",
    signedInAs: "Signed in as",
    keptUntil:
      "Your journeys are kept until {date}, three years after your last visit. They are never given to a partner.",
    checkAddress: "Check your address, then try again.",
    removeSpace: "Delete your space?",
    removeSpaceText:
      "Your address, all your journeys and all your answers are erased straight away, including your news sign-up. This cannot be undone.",
    removeAll: "Delete everything",
    keepSpace: "Keep my space",
    removed: "Your space is deleted.",
  },
} satisfies Bilingual<Record<string, string>>;
---

<Page title={copy.title} description={copy.description}>
  <h1 data-copy={JSON.stringify(SCRIPT_COPY[locale])} id="space-title">
    {copy.title}
  </h1>
  <p class="lead" id="who" hidden></p>
  <p class="notice" id="notice" role="status" hidden></p>

  <section id="signed-out" class="block" hidden>
    <p class="lead">{copy.lead}</p>
    <form id="login" novalidate>
      <label class="field">
        {copy.email}
        <input
          type="email"
          name="email"
          placeholder={copy.emailPlaceholder}
          autocomplete="email"
          required
        />
      </label>
      <p class="error" id="login-error" role="alert" hidden></p>
      <button type="submit" class="primary">
        {copy.getLink}
      </button>
    </form>
    <div class="panel done" id="login-sent" role="status" hidden>
      <p>
        <b>{copy.checkInbox}</b>
      </p>
      <p class="dim">{copy.linkComing}</p>
    </div>
  </section>

  <section id="signed-in" class="block" hidden>
    <section aria-labelledby="journeys-title" class="block">
      <h2 id="journeys-title">{copy.journeys}</h2>
      <p class="dim" id="no-journey" hidden>
        {copy.noJourney} <a href={pathFor("home", locale)}>{copy.takeQuiz}</a>
      </p>
      <ul id="journeys" class="journeys"></ul>
    </section>

    <section aria-labelledby="data-title" class="panel">
      <h2 id="data-title">{copy.data}</h2>
      <p class="dim" id="kept"></p>
      <label class="consent">
        <input type="checkbox" id="news" />
        <span>{copy.news}</span>
      </label>
      <a class="pill" href="/api/compte/export" download>
        {copy.download}
      </a>
      <button type="button" class="danger" id="delete-all">
        {copy.deleteAll}
      </button>
    </section>

    <button type="button" class="quiet" id="logout">
      {copy.logout}
    </button>
  </section>

  <dialog id="confirm" class="confirm" aria-labelledby="confirm-title">
    <h2 id="confirm-title"></h2>
    <p class="dim" id="confirm-text"></p>
    <div class="row">
      <button type="button" class="danger-fill" id="confirm-yes"></button>
      <button type="button" class="outline" id="confirm-no"></button>
    </div>
  </dialog>
</Page>

<script>
  import { dateLabel, journeySummary, resultsHref, resumeHref, type Journey } from "../lib/account";
  import { pageLocale } from "../i18n/locale";
  import { api, rememberJourney, resume } from "../lib/account-dom";
  import { outcomeOf } from "../lib/newsletter";

  const locale = pageLocale();
  const copy = JSON.parse(document.getElementById("space-title")!.dataset.copy!) as Record<
    string,
    string
  >;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const notice = (text: string) => {
    $("notice").textContent = text;
    $("notice").hidden = false;
  };

  /** « Supprimer » asks first, in a dialog, and says it cannot be undone. */
  function confirmFirst(title: string, text: string, yes: string, no: string): Promise<boolean> {
    const dialog = $<HTMLDialogElement>("confirm");
    $("confirm-title").textContent = title;
    $("confirm-text").textContent = text;
    $("confirm-yes").textContent = yes;
    $("confirm-no").textContent = no;
    dialog.showModal();
    return new Promise((done) => {
      const close = (answer: boolean) => {
        dialog.close();
        done(answer);
      };
      $("confirm-yes").onclick = () => close(true);
      $("confirm-no").onclick = () => close(false);
      dialog.oncancel = () => done(false);
    });
  }

  function journeyItem(journey: Journey) {
    const summary = journeySummary(journey, locale);
    const item = document.createElement("li");
    item.className = "journey";
    const head = document.createElement("div");
    head.className = "journey-head";
    const title = document.createElement("h3");
    title.textContent = summary.title;
    const date = document.createElement("span");
    date.className = "dim";
    date.textContent = journey.updatedAt ? dateLabel(journey.updatedAt, locale) : "";
    head.append(title, date);
    const detail = document.createElement("p");
    detail.className = "dim";
    detail.textContent = summary.cities.length
      ? summary.cities.map((c, i) => `${i + 1}. ${c.name} · ${c.percent} %`).join(" — ")
      : summary.answered;
    const row = document.createElement("div");
    row.className = "row";
    const go = document.createElement("a");
    go.className = "go";
    go.href = resumeHref(journey.id, locale);
    go.textContent = copy.resume;
    go.addEventListener("click", () => resume(journey));
    const results = document.createElement("a");
    results.className = "go";
    results.href = resultsHref(journey.id, locale);
    results.textContent = copy.results;
    results.addEventListener("click", () => resume(journey));
    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "danger";
    remove.textContent = copy.remove;
    remove.addEventListener("click", async () => {
      const sure = await confirmFirst(
        copy.removeJourney,
        copy.removeJourneyText,
        copy.remove,
        copy.keep,
      );
      if (!sure) return;
      const { status } = await api("DELETE", `/api/compte/parcours/${journey.id}`);
      if (status === 200) show();
    });
    row.append(...(summary.cities.length ? [results] : []), go, remove);
    item.append(head, detail, row);
    return item;
  }

  async function show() {
    const { status, data } = await api("GET", "/api/compte");
    const signedIn = status === 200;
    $("signed-in").hidden = !signedIn;
    $("signed-out").hidden = signedIn;
    $("who").hidden = !signedIn;
    if (!signedIn) return;
    $("who").textContent = `${copy.signedInAs} ${data.email}`;
    const journeys = data.journeys as Journey[];
    $("journeys").replaceChildren(...journeys.map(journeyItem));
    $("no-journey").hidden = journeys.length > 0;
    $("kept").textContent = copy.keptUntil.replace("{date}", dateLabel(data.keptUntil, locale));
    $<HTMLInputElement>("news").checked = Boolean(data.news);
    // Arrived from the results e-mail's button: straight to that result.
    const opened = journeys.find(
      (j) => j.id === new URLSearchParams(location.search).get("ouvrir"),
    );
    if (opened) {
      resume(opened);
      location.replace(resultsHref(opened.id, locale));
    }
  }

  $("login").addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = String(new FormData(event.target as HTMLFormElement).get("email") ?? "").trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      $("login-error").textContent = copy.checkAddress;
      $("login-error").hidden = false;
      return;
    }
    const { status } = await api("POST", "/api/compte/lien", { email, locale });
    const outcome = outcomeOf(status, "results", locale);
    if (!outcome.sent) {
      $("login-error").textContent = outcome.message;
      $("login-error").hidden = false;
      return;
    }
    $("login").hidden = true;
    $("login-sent").hidden = false;
  });

  $<HTMLInputElement>("news").addEventListener("change", async (event) => {
    await api("PATCH", "/api/compte", {
      news: (event.target as HTMLInputElement).checked,
      locale,
    });
  });

  $("delete-all").addEventListener("click", async () => {
    const sure = await confirmFirst(
      copy.removeSpace,
      copy.removeSpaceText,
      copy.removeAll,
      copy.keepSpace,
    );
    if (!sure) return;
    const { status } = await api("DELETE", "/api/compte");
    if (status !== 200) return;
    rememberJourney(null);
    await show();
    notice(copy.removed);
  });

  $("logout").addEventListener("click", async () => {
    await api("POST", "/api/compte/deconnexion");
    rememberJourney(null);
    show();
  });

  show();
</script>

<style>
  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.2rem, 8vw, 3rem);
    line-height: 1;
    margin: 0;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  p {
    margin: 0;
  }
  [hidden] {
    display: none !important;
  }
  .lead,
  .dim {
    color: var(--thread-dim);
    font-size: 0.92rem;
  }
  .dim a {
    color: var(--saffron);
  }
  .notice {
    font-weight: 700;
  }
  .block,
  form {
    display: grid;
    gap: 14px;
  }
  .panel {
    display: grid;
    gap: 12px;
    background: var(--night-deep);
    border: 1px solid var(--night-lift);
    border-radius: 20px;
    padding: 18px;
  }
  .panel.done {
    border: 2px solid var(--saffron);
  }
  .field {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  input[type="email"] {
    min-height: 48px;
    box-sizing: border-box;
    border-radius: 14px;
    border: 2px solid var(--thread-dim);
    background: var(--night-deep);
    color: var(--thread);
    padding: 0 14px;
    font: inherit;
  }
  .consent {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    font-size: 0.92rem;
  }
  .consent input {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--saffron);
  }
  .error {
    color: var(--coral);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .primary,
  .go,
  .danger-fill,
  .outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font: inherit;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
  }
  .primary {
    min-height: 54px;
    border: 0;
    background: var(--saffron);
    color: var(--ink);
  }
  .go {
    background: var(--saffron);
    color: var(--ink);
  }
  .danger-fill {
    border: 0;
    background: var(--coral);
    color: var(--ink);
  }
  .outline {
    border: 2px solid var(--thread);
    background: transparent;
    color: var(--thread);
  }
  .pill {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 2px solid var(--thread-dim);
    color: var(--thread);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .danger,
  .quiet {
    justify-self: start;
    min-height: 44px;
    padding: 0 4px;
    border: 0;
    background: transparent;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .danger {
    color: var(--coral);
  }
  .quiet {
    color: var(--thread-dim);
    font-weight: 400;
  }
  .journeys {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  /* Journey cards are built in the browser: their parts need :global to get these rules. */
  .journeys :global(h3) {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .journeys :global(.dim) {
    margin: 0;
    color: var(--thread-dim);
    font-size: 0.92rem;
  }
  .journeys :global(.go) {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
  }
  .journeys :global(.danger) {
    min-height: 44px;
    padding: 0 4px;
    border: 0;
    background: transparent;
    color: var(--coral);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .journeys :global(.journey) {
    display: grid;
    gap: 10px;
    background: var(--night-deep);
    border: 1px solid var(--night-lift);
    border-radius: 18px;
    padding: 18px;
  }
  .journeys :global(.journey:first-child) {
    border: 2px solid var(--saffron);
  }
  .journeys :global(.journey-head) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .row,
  .journeys :global(.row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .confirm {
    max-width: 400px;
    border: 2px solid var(--coral);
    border-radius: 20px;
    background: var(--night-deep);
    color: var(--thread);
    padding: 20px;
  }
  .confirm[open] {
    display: grid;
    gap: 12px;
  }
  .confirm::backdrop {
    background: color-mix(in srgb, var(--scrim) 70%, transparent);
  }
</style>
